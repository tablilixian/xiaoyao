<!DOCTYPE html>
<html lang="zh-CN">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>逍遥小散仙 - 知识图谱</title>
    <script src="https://d3js.org/d3.v7.min.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/echarts@5.4.3/dist/echarts.min.js"></script>
    <style>
        * {
            margin: 0;
            padding: 0;
            box-sizing: border-box;
        }
        body {
            font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', 'PingFang SC', 'Hiragino Sans GB', 'Microsoft YaHei', sans-serif;
            background: #0d0d15;
            color: #e8e4dc;
            min-height: 100vh;
        }
        header {
            background: linear-gradient(135deg, #1a1a25 0%, #0d0d15 100%);
            padding: 20px 40px;
            border-bottom: 1px solid #2a2a3a;
        }
        .header-content {
            max-width: 1600px;
            margin: 0 auto;
            display: flex;
            justify-content: space-between;
            align-items: center;
        }
        .logo {
            display: flex;
            align-items: center;
            gap: 15px;
        }
        .logo-icon {
            width: 50px;
            height: 50px;
            background: linear-gradient(135deg, #d4a574, #5a9a8f);
            border-radius: 12px;
            display: flex;
            align-items: center;
            justify-content: center;
            font-size: 24px;
            font-weight: 700;
            color: #1a1a25;
        }
        .logo-text h1 {
            font-size: 24px;
            font-weight: 600;
            background: linear-gradient(135deg, #e8e4dc, #d4a574);
            -webkit-background-clip: text;
            -webkit-text-fill-color: transparent;
            background-clip: text;
        }
        .logo-text p {
            font-size: 13px;
            color: #888;
            margin-top: 2px;
        }
        .nav-tabs {
            display: flex;
            gap: 10px;
        }
        .nav-tab {
            padding: 10px 20px;
            background: transparent;
            border: 1px solid #2a2a3a;
            border-radius: 8px;
            color: #888;
            cursor: pointer;
            transition: all 0.3s ease;
            font-size: 14px;
        }
        .nav-tab:hover {
            background: rgba(212, 165, 116, 0.1);
            border-color: #d4a574;
            color: #d4a574;
        }
        .nav-tab.active {
            background: rgba(212, 165, 116, 0.15);
            border-color: #d4a574;
            color: #d4a574;
        }
        main {
            max-width: 1600px;
            margin: 0 auto;
            padding: 30px 40px;
        }
        .stats-grid {
            display: grid;
            grid-template-columns: repeat(4, 1fr);
            gap: 20px;
            margin-bottom: 30px;
        }
        .stat-card {
            background: linear-gradient(135deg, rgba(26, 26, 37, 0.8), rgba(13, 13, 21, 0.9));
            border: 1px solid #2a2a3a;
            border-radius: 12px;
            padding: 20px;
            text-align: center;
            transition: all 0.3s ease;
        }
        .stat-card:hover {
            border-color: #d4a574;
            transform: translateY(-2px);
        }
        .stat-number {
            font-size: 32px;
            font-weight: 700;
            background: linear-gradient(135deg, #d4a574, #5a9a8f);
            -webkit-background-clip: text;
            -webkit-text-fill-color: transparent;
            background-clip: text;
        }
        .stat-label {
            font-size: 13px;
            color: #888;
            margin-top: 5px;
        }
        .main-panel {
            display: grid;
            grid-template-columns: 1fr 350px;
            gap: 25px;
        }
        .graph-container {
            background: linear-gradient(135deg, rgba(26, 26, 37, 0.8), rgba(13, 13, 21, 0.9));
            border: 1px solid #2a2a3a;
            border-radius: 12px;
            height: 700px;
            position: relative;
            overflow: hidden;
        }
        .graph-header {
            position: absolute;
            top: 20px;
            left: 20px;
            right: 20px;
            display: flex;
            justify-content: space-between;
            align-items: center;
            z-index: 10;
        }
        .graph-title {
            font-size: 18px;
            font-weight: 600;
            color: #e8e4dc;
        }
        .graph-controls {
            display: flex;
            gap: 10px;
        }
        .control-btn {
            padding: 8px 16px;
            background: rgba(212, 165, 116, 0.1);
            border: 1px solid rgba(212, 165, 116, 0.3);
            border-radius: 6px;
            color: #d4a574;
            cursor: pointer;
            font-size: 13px;
            transition: all 0.3s ease;
        }
        .control-btn:hover {
            background: rgba(212, 165, 116, 0.2);
        }
        #graph-svg, #faction-graph-svg, #location-graph-svg {
            width: 100%;
            height: 100%;
        }
        .legend {
            position: absolute;
            bottom: 20px;
            left: 20px;
            background: rgba(26, 26, 37, 0.95);
            border: 1px solid #2a2a3a;
            border-radius: 8px;
            padding: 15px;
            font-size: 12px;
        }
        .legend-title {
            font-weight: 600;
            margin-bottom: 10px;
            color: #e8e4dc;
        }
        .legend-item {
            display: flex;
            align-items: center;
            gap: 8px;
            margin-bottom: 6px;
        }
        .legend-dot {
            width: 12px;
            height: 12px;
            border-radius: 50%;
        }
        .sidebar {
            display: flex;
            flex-direction: column;
            gap: 20px;
        }
        .panel {
            background: linear-gradient(135deg, rgba(26, 26, 37, 0.8), rgba(13, 13, 21, 0.9));
            border: 1px solid #2a2a3a;
            border-radius: 12px;
            padding: 20px;
        }
        .panel-title {
            font-size: 15px;
            font-weight: 600;
            color: #e8e4dc;
            margin-bottom: 15px;
            padding-bottom: 10px;
            border-bottom: 1px solid #2a2a3a;
        }
        .search-box {
            position: relative;
            margin-bottom: 15px;
        }
        .search-box input {
            width: 100%;
            padding: 10px 15px;
            padding-right: 40px;
            background: rgba(255, 255, 255, 0.05);
            border: 1px solid #2a2