    "relationships": [
      {
        "with": "崔小玄",
        "type": "superior",
        "description": "小玄以役妖令拘唤呲铁族力士恶军助战，恶军称小玄为'小主公'，以神力击溃云州骑兵为大军打开突破口。恶军后被忘川莲华禁制拘回御牢",
        "type_cn": "上级"
      }
    ],
    "artifacts": [
      "兽皮囊"
    ],
    "supplement_desc": "一个身披甲胄的牛首力士，皮毛漆黑，顶有巨角，耗费两颗符石。 役妖令注：恶军，呲铁族力士。犯御厨偷食之罪，惩狱二千六百年。善搬运，力大无穷，能担山托海。"
  },
  "玉矶": {
    "name": "玉矶",
    "type": "minor",
    "gender": "女",
    "appearances": [
      19
    ],
    "aliases": [
      "石之精灵"
    ],
    "faction": "妖界御牢罪妖",
    "description": "",
    "personality": "",
    "appearance": "",
    "image": null,
    "relationships": [
      {
        "with": "崔小玄",
        "type": "superior",
        "description": "小玄以役妖令拘唤石之精灵玉矶救援百宝娘娘，玉矶称小玄为'小主公'，以六合幻影术和气血荆棘术轻松制服战奴与铁塔将军。玉矶后被忘川莲华禁制拘回御牢",
        "type_cn": "上级"
      }
    ],
    "weapons": [
      "云雪沐：一支奇异的碧柄拂尘。柄身淡碧",
      "万缕柔丝宛如炁编气织",
      "舞动起来",
      "流云飞雪般柔柔飘动。神兵上宝",
      "于"
    ],
    "supplement_desc": "一个道装美人，容颜衣饰皆十分脱俗秀丽。原乃天地玄黄之外的一颗顽石，经地水火风，汲天地灵气，修炼千万年方成精灵。石矶之胞妹。 役妖令注：玉矶，石之精灵。犯寻仇滋事罪，惩狱九千九百年。善术，识上古奇术。耗费十一颗符石。"
  },
