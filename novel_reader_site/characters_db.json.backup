    "aliases": [],
    "faction": "华浓庄",
    "description": "",
    "personality": "",
    "appearance": "",
    "image": "images/character_007.jpg",
    "relationships": [
      {
        "with": "崔小玄",
        "type": "protector",
        "description": "小玄教夭夭说话和人情世故，夭夭初成人形每日只能在瓶外待一个时辰，对小玄有不舍之情",
        "type_cn": "保护者"
      },
      {
        "with": "玉桃娘娘",
        "type": "superior",
        "description": "千年老桃树独蕾桃枝所化精灵，玉桃娘娘千百个孩儿中最得意的一个",
        "type_cn": "上级"
      },
      {
        "with": "崔小玄",
        "type": "lover",
        "description": "小玄失忆后从如意囊中释放出青瓷瓶内的夭夭，夭夭认出小玄但小玄不记得她。夭夭因在迷林中饱沐玄阳至精，加太华轩灵气郁盛，能一直保持人形。两人恢复亲密关系，多次发生关系。夭夭对小玄极度依恋，帮他收拾屋子、端茶递水，害怕生人时会雾化隐匿",
        "type_cn": "恋人"
      },
      {
        "with": "玉桃娘娘",
        "type": "parent",
        "description": "夭夭为桃花精，是玉桃娘娘之女，初成人形，每日只能在瓶子外待一个时辰",
        "type_cn": "父母"
      },
      {
        "with": "摘霞",
        "type": "enemy",
        "description": "摘霞闯入小玄卧房撞见夭夭与小玄亲热，认定夭夭是迷惑师兄的妖精，施展破邪印法直奔夭夭雪额，小玄大惊担心夭夭灰飞烟灭",
        "type_cn": "敌人"
      },
      {
        "with": "绮姬",
        "type": "master",
        "description": "绮姬（娘娘）很久以前就教夭夭要好好服侍小玄，并教授夭夭借形术",
        "type_cn": "师父"
      },
      {
        "with": "崔小玄",
        "type": "sibling",
        "description": "崔小玄在绝望中想到'夭夭怎么办？没有人放她出来，没有人给她浇水'",
        "type_cn": "兄弟姐妹"
      },
      {
        "with": "玉桃娘娘",
        "type": "parent",
        "description": "夭夭称玉桃娘娘为娘亲。玉桃娘娘要夭夭跟在小玄身边服侍他。夭夭时常待在青瓷瓶中",
        "type_cn": "父母"
      },
      {
        "with": "崔小玄",
        "type": "lover",
        "description": "夭夭为桃精，与小玄在迷林中已有多时亲密关系。因饱沐玄阳至精能保持人形。对小玄极度依恋，帮他收拾屋子、端茶递水。害怕生人时会雾化隐匿",
        "type_cn": "恋人"
      },
      {
        "with": "崔小玄",
        "type": "friend",
        "description": "小玄返回玉京后先到太华轩后园见夭夭与大宝，后将夭夭引见给皇后，获准留在雍怡宫",
        "type_cn": "朋友"
      }
    ],
    "spells": [
      "借形术",
      "搬运之术"
    ],
    "supplement_desc": "玉泉谷中一株千年老桃之上的唯一一根桃枝上的精灵，而桃枝茎身剔透，蕾嫩如粉，与众不同。夭夭天生异质，一成人形就具雾化之能，而且资质好，学东西甚快。"
  },
