  "易寻烟": {
    "name": "易寻烟",
    "type": "minor",
    "gender": "男",
    "appearances": [
      5,
      10
    ],
    "aliases": [
      "孤烟岛散人",
      "天外孤烟",
      "六师伯"
    ],
    "faction": "玄教",
    "description": "",
    "personality": "",
    "appearance": "",
    "image": null,
    "relationships": [
      {
        "with": "崔采婷",
        "type": "senior",
        "description": "易寻烟为玄教六师伯，崔采婷的师兄。崔采婷对易寻烟态度冷淡坚决不见，暗示两人有复杂过往。易寻烟直呼崔采婷名'婷儿'时她曾动容",
        "type_cn": "前辈"
      },
      {
        "with": "飞萝",
        "type": "ally",
        "description": "飞萝不顾崔采婷禁令去见六师伯易寻烟，两人在后山切磋功法。后为保护小玄联手拖住易寻烟",
        "type_cn": "盟友"
      },
      {
        "with": "崔小玄",
        "type": "enemy",
        "description": "易寻烟认定小玄是妖狐玄玄子遗孽，要将其带回凤凰崖交教尊发落。虽最终选择不追，但暗中释放白光追踪",
        "type_cn": "敌人"
      },
      {
        "with": "绮姬",
        "type": "enemy",
        "description": "易寻烟追踪绮姬至翠华庐附近，以辟邪真气损绮姬真元。揭露绮姬为盗猎孤烟岛犀渠兽的主谋",
        "type_cn": "敌人"
      },
      {
        "with": "雷将（紫甲怪神）",
        "type": "superior",
        "description": "易寻烟以雷霆秘典从上界雷府社令院拘来雷将，命其追捕小玄",
        "type_cn": "上级"
      },
      {
        "with": "雪涵",
        "type": "senior",
        "description": "易寻烟空中接住从骷髅战车坠落的雪涵，并以正元真气一袖击退骷髅老祖",
        "type_cn": "前辈"
      },
      {
        "with": "骷髅老祖",
        "type": "enemy",
        "description": "易寻烟以正元真气破骷髅老祖护体魔功，冲散其修炼千万年的真元，骷髅老祖败逃",
        "type_cn": "敌人"
      },
      {
        "with": "凌傲天",
        "type": "enemy",
        "description": "易寻烟以辟邪真气绝顶神通龙罡连败凌傲天，毁其真元令战力大跌",
        "type_cn": "敌人"
      },
      {
        "with": "吞天大将军",
        "type": "enemy",
        "description": "易寻烟以龙罡击退吞天大将军，但随后被午十琴音突袭陷入困境",
        "type_cn": "敌人"
      },
      {
        "with": "午十",
        "type": "enemy",
        "description": "午十以魔琴夺魂之音突袭易寻烟令其全身麻痹动弹不得，后与万毒老君夹击易寻烟",
        "type_cn": "敌人"
      },
      {
        "with": "万毒老君",
        "type": "enemy",
        "description": "万毒老君以蚀魄神光夹击易寻烟，易寻烟冒死引天雷之力反击重创万毒老君",
        "type_cn": "敌人"
      },
      {
        "with": "碧怜怜",
        "type": "enemy",
        "description": "碧怜怜以魇鸢之术一击制服易寻烟，将其与崔采婷等众姝尽数以星罗帕摄入帕中带走",
        "type_cn": "敌人"
      },
      {
        "with": "李梦棠",
        "type": "ally",
        "description": "李梦棠为被俘后中毒的易寻烟施针救治",
        "type_cn": "盟友"
      }
    ],
    "techniques": [
      "辟邪真气",
      "雷霆秘典"
    ],
    "martial_arts": [
      "龙罡"
    ],
    "artifacts": [
      "云翼鼎"
    ],
    "armor": [
      "雷府神将"
    ],
    "supplement_desc": "玄教第三代弟子排行第六。号天外孤烟。修为已近太乙之境。自称孤烟岛散人。玄教的护教尊者，修为高绝，一身玄异真气已臻化境，据传曾经诛伏过地界七七四十九洞妖王，名震大荒。炼气大家，若论真气，可排入玄教三名之内。擅长追踪术和御甲术。两条臂膀被玄狐所废。"
  },
