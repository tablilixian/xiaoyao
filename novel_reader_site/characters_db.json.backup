    "appearances": [
      7
    ],
    "aliases": [],
    "faction": "截教",
    "description": "",
    "personality": "",
    "appearance": "",
    "image": null,
    "relationships": [
      {
        "with": "葫芦镇",
        "type": "superior",
        "description": "截教门人空空老仙为通天教主故友，封神劫中唯一幸存的截教门人，占据水晶潭建立葫芦镇，天上地下无人敢染指",
        "type_cn": "上级"
      },
      {
        "with": "水晶潭",
        "type": "superior",
        "description": "空空老仙守护水晶潭，水晶潭为地界一十九灵脉之一，产出水晶淖",
        "type_cn": "上级"
      },
      {
        "with": "扈星飞",
        "type": "senior",
        "description": "扈星飞师从杳杳真人，杳杳真人为空空老仙弟子，故空空老仙为扈星飞的师祖。红叶识破扈星飞所用剑法为截教碧游剑法，认出其佩剑照天紫电",
        "type_cn": "前辈"
      },
      {
        "with": "杳杳真人",
        "type": "master",
        "description": "杳杳真人为空空老仙的弟子，素来低调。扈星飞为其弟子",
        "type_cn": "师父"
      }
    ],
    "supplement_desc": "截教门人、通天教主的故友空空，据传此祖当年看破万仙之劫，于封神期间，至始至终闭门不出，是以截教之中，只有他逃得一辱。据传他的修为不在通天教主之下，当初加入截教只是为了要窥探鸿钧道术，而且他素来心性淡泊，只好参玄悟妙，比通天教主看得多一点远一点也不奇怪。"
  },
