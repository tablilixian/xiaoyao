      },
      {
        "with": "飞萝",
        "type": "protector",
        "description": "小妖后将飞萝带往小琳琅天，告知其内丹已失，并讲述灵鳌鸣示天地大劫的传说及足以毁灭玄狐的秘密",
        "type_cn": "保护者"
      },
      {
        "with": "重元子",
        "type": "enemy",
        "description": "小妖后与重元子交手后亦受伤委顿，坐镇小琳琅天行宫",
        "type_cn": "敌人"
      },
      {
        "with": "崔小玄",
        "type": "ambiguous",
        "description": "小妖后向飞萝透露足以毁灭玄狐的秘密，暗示小玄身世秘密的危险性",
        "type_cn": "暧昧"
      },
      {
        "with": "飞萝",
        "type": "ally",
        "description": "飞萝向小妖后透露先天太幻图的弱点与施放条件",
        "type_cn": "盟友"
      },
      {
        "with": "凌霄士",
        "type": "superior",
        "description": "小妖后在娲皇殿召见妖圣凌霄士，讨论雷域躁动及拘缨失盗之事，委托凌霄士调查广莽极北的神秘鲲鹏",
        "type_cn": "上级"
      },
      {
        "with": "龙逄",
        "type": "superior",
        "description": "小妖后密令镇界大将军龙逄率本部精锐（八千御前右护卫军及七员爱将）离开妖界隐匿，作为应对天地大劫的退路",
        "type_cn": "上级"
      },
      {
        "with": "摩珈女王",
        "type": "rival",
        "description": "摩珈女王曾挑战小妖后两次，九千三百年前携族攻打快活岛被击败",
        "type_cn": "对手"
      },
      {
        "with": "飞萝",
        "type": "master",
        "description": "小妖后（圣后）赠飞萝乾坤铸真丹（阴丹），可增万载修为，并托付飞萝护持崔小玄",
        "type_cn": "师父"
      },
      {
        "with": "崔小玄",
        "type": "guardian",
        "description": "圣后预见天地剧变，托付飞萝护持崔小玄，预见或将无暇他顾",
        "type_cn": "守护者"
      },
      {
        "with": "师南生",
        "type": "ally",
        "description": "师南生在大琳琅天目睹洪荒炉开启及紫犀钗重铸过程。",
        "type_cn": "盟友"
      },
      {
        "with": "卿卿",
        "type": "superior",
        "description": "卿卿为小妖后身边的白裳少女，活泼狡黠，手持大葫芦",
        "type_cn": "上级"
      },
      {
        "with": "天羽大圣老",
        "type": "subordinate",
        "description": "天羽大圣老为妖界八大元老之一，鹤发赤颊脖颈细长，身笼白云青松袍",
        "type_cn": "下属"
      },
      {
        "with": "八大元老",
        "type": "superior",
        "description": "小妖后在八大元老协助下于大琳琅天洪荒炉开启重铸紫犀钗，疑似因重铸而倒下。",
        "type_cn": "上级"
      }
    ],
