        "with": "崔小玄",
        "type": "lover",
        "description": "糖妃对小玄一见倾心，主动约其夜间相会，表白喜欢他。两人在假山洞中别有洞天的采华神木下亲密。身上散发细腻甜香",
        "type_cn": "恋人"
      },
      {
        "with": "晁紫阁",
        "type": "spouse",
        "description": "糖妃为淑妃，骠骑大将军唐凤山之女。在宫中无知心人，对小玄倾诉宫中勾心斗角",
        "type_cn": "配偶"
      },
      {
        "with": "罗才人",
        "type": "ally",
        "description": "罗才人为褒国公罗子顼孙女，去年入宫，与糖妃、龚才人交好",
        "type_cn": "盟友"
      },
      {
        "with": "龚才人",
        "type": "ally",
        "description": "龚才人为将作大匠龚世弘之女，去年入宫，与糖妃、罗才人交好",
        "type_cn": "盟友"
      },
      {
        "with": "龚才人",
        "type": "ally",
        "description": "龚才人与糖妃关系极为密切，一同与小玄私会",
        "type_cn": "盟友"
      },
      {
        "with": "罗才人",
        "type": "ally",
        "description": "罗才人与糖妃关系极为密切，一同与小玄私会",
        "type_cn": "盟友"
      },
      {
        "with": "甜儿",
        "type": "subordinate",
        "description": "甜儿为小宫婢，为三妃与小玄牵线联络",
        "type_cn": "下属"
      },
      {
        "with": "汤国璋",
        "type": "parent",
        "description": "糖妃（汤贵妃）为当朝宰相汤国璋之女，地位超然",
        "type_cn": "父母"
      }
    ],
    "artifacts": [
      "夜魅"
    ],
    "maids": [
      "甜儿"
    ],
    "supplement_desc": "淑妃，居住在熙华宫。皇朝当今四大梁柱之一的骠骑大将军唐凤山之女，入宫之后，极得皇上恩宠，接连晋封，今已为淑妃，因姓唐，又爱甜，皇上赐了个糖字，是以宫里都称其为糖妃。宫中最擅舞的三妃其一。"
  },
  "逍遥郎君": {
    "name": "逍遥郎君",
    "type": "core",
    "gender": "男",
    "appearances": [
      13,
      14,
      16,
      17,
      18,
      21
    ],
    "aliases": [
      "逍遥郎君",
      "三哥（四癫排行）",
      "烛鼎玄（真名）"
    ],
    "faction": "逍遥门",
    "description": "",
    "personality": "",
    "appearance": "",
    "image": null,
    "relationships": [
      {
        "with": "崔小玄",
        "type": "rival",
        "description": "仙灵大会决赛中，小玄以大宝对战逍遥郎君的蟹霸王，大宝展现五元归宗、大地之缚等高级法符，最终令蟹霸王失去动海钟后被困，逍遥郎君认输。小玄夺魁封少国师。逍遥郎君遣紫发丽姬送如意百宝匣（内藏淫具）及请柬，意图拉拢",
        "type_cn": "对手"
      },
      {
        "with": "武翩跹",
        "type": "enemy",
        "description": "逍遥郎君献颤声娇与七步回心极乐散给皇帝算计武翩跹。武翩跹对其极为反感，称其为龌龊野人",
        "type_cn": "敌人"
      },
      {
        "with": "晁紫阁",
        "type": "ally",
        "description": "逍遥郎君乘白龙至迷楼，献颤声娇与七步回心极乐散。皇帝与之相处甚欢，赞其风神秀逸，让其在龙床右下入座，殊为荣耀",
        "type_cn": "盟友"
      },
      {
        "with": "龙九公主",
        "type": "subordinate",
        "description": "龙九公主蒙面操控蟹霸王参加仙灵大会，为逍遥郎君出战。面纱被大宝揭去后显露真容。实为西海龙王敖钦之女",
        "type_cn": "下属"
      },
      {
        "with": "贺天雕",
        "type": "rival",
        "description": "逍遥郎君蟹霸王以两击击败贺天雕的地狱三首神犬，贺天雕雄心尽碎",
        "type_cn": "对手"
      },
      {
        "with": "卜轩司",
        "type": "rival",
        "description": "卜轩司以天机九变对战蟹霸王惨败，天机九变被蟹霸王的龙魄之力吞噬瓦解。国师颜面尽失",
        "type_cn": "对手"
      },
      {
        "with": "琅邪双璧",
        "type": "rival",
        "description": "逍遥郎君蟹霸王以漩涡之力困住琅邪双璧的灵鹤令其丧失抵抗，轻松取胜",
        "type_cn": "对手"
      },
      {
        "with": "紫发丽姬",
        "type": "subordinate",
        "description": "紫发丽姬为逍遥郎君身边三大丽姬之一，发丝隐呈绯紫色，声音软糯。逍遥郎君遣其送如意百宝匣及请柬给小玄",
        "type_cn": "下属"
      },
      {
        "with": "崔小玄",
        "type": "rival",
        "description": "仙灵大会决赛中逍遥郎君的蟹霸王被小玄的大宝击败，动海钟被迫脱离。逍遥郎君认输后赠小玄如意百宝匣（内藏淫具）及请柬，意图拉拢",
        "type_cn": "对手"
      },
      {
        "with": "龙九公主",
        "type": "superior",
        "description": "龙九公主为西海龙王敖钦之女，蒙面操控蟹霸王为逍遥郎君出战仙灵大会。面纱被揭后显露真容",
        "type_cn": "上级"
      },
      {
        "with": "贺天雕",
        "type": "rival",
        "description": "贺天雕的地狱三首神犬被蟹霸王两击击败，雄心尽碎",
        "type_cn": "对手"
      },
      {
        "with": "钟晋",
        "type": "rival",
        "description": "钟晋的狴犴铜兽被逍遥郎君的蟹霸王击败",
        "type_cn": "对手"
      },
      {
        "with": "由吾璟",
        "type": "rival",
        "description": "琅邪双璧的灵鹤被蟹霸王以漩涡之力困住丧失抵抗",
        "type_cn": "对手"
      },
      {
        "with": "陆安清",
        "type": "rival",
        "description": "陆安清的千足蜈蚣（梅精幻化）曾败于逍遥郎君身边丽姬击毁甲兵",
        "type_cn": "对手"
      },
      {
        "with": "卜轩司",
        "type": "rival",
        "description": "卜轩司天机九变被蟹霸王的龙魄之力吞噬瓦解，国师大败",
        "type_cn": "对手"
      },
      {
        "with": "皇后",
        "type": "master",
        "description": "皇后为东海逍遥门弟子，逍遥郎君为其师父。皇后修有还形铸体水髓咒、拘龙锁等采补秘技，有四大心腹宫娥簪儿、珰儿、镯儿、璧儿",
        "type_cn": "师父"
      },
      {
        "with": "玄狐",
        "type": "nemesis",
        "description": "逍遥郎君与玄狐斗了一世争了一世，认为小玄可能是玄狐转世",
