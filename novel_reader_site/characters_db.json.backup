    "personality": "",
    "appearance": "",
    "image": null,
    "relationships": [
      {
        "with": "崔小玄",
        "type": "enemy",
        "description": "冥咒世尊为冥族六大世尊之一，额生竖眼，手执巫帝遗宝'岁月'杖，修碧落黄泉诀。第196回小玄与百宝娘娘联手伏击冥咒世尊，小玄以诛天诀'不离不弃'锁杀世尊，剑刺其右肩，致其断臂逃脱。",
        "type_cn": "敌人"
      },
      {
        "with": "百宝娘娘",
        "type": "enemy",
        "description": "百宝娘娘以十余件法宝齐发合围冥咒世尊，再以雷电罍重创之。后百宝娘娘被冥咒世尊以魔眼及威煞重创功法溃散，又被蛛网缠住跌入蛛网深渊。",
        "type_cn": "敌人"
      },
      {
        "with": "程兆琦",
        "type": "enemy",
        "description": "冥咒世尊坐镇青冥祭坛看守被囚的程兆琦（元帅），曾重创程兆琦，亦曾潜入迷楼行刺晁紫阁。",
        "type_cn": "敌人"
      },
      {
        "with": "阿呆",
        "type": "master",
        "description": "阿呆为冥咒世尊弟子，僮子打扮，看似呆头呆脑实则深藏不露，持有鬼面布袋法囊。世尊称其为'宝贝孩儿'。",
        "type_cn": "师父"
      },
      {
        "with": "青面蝎魔",
        "type": "subordinate",
        "description": "青面蝎魔为太幽宫十卫之一，靛面蓝发形貌凶厉，跨坐披甲巨蝎，手提巨叉，统领八百蝎子卫。第195回向冥咒世尊传达大宫主谕令。",
        "type_cn": "下属"
      },
      {
        "with": "大宫主",
        "type": "ally",
        "description": "大宫主与冥咒世尊同属冥界阵营，在青冥祭坛共同作战",
        "type_cn": "盟友"
      },
      {
        "with": "炼狱世尊",
        "type": "ally",
        "description": "同为冥界六大世尊，在青冥祭坛共同对抗小玄等人",
        "type_cn": "盟友"
      }
    ],
    "weapons": [
      "岁月"
    ],
    "supplement_desc": "数月前曾入宫行刺晁紫阁未果，数日前重创程兆琦。"
