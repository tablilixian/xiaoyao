        "with": "贺天鹏",
        "type": "ally",
        "description": "贺天鹏为荡魔堡少堡主，率大批伏魔好手前来泽阳助阵抵御邪秽",
        "type_cn": "盟友"
      },
      {
        "with": "古将军",
        "type": "superior",
        "description": "方少麟恢复布防后命古将军与孟统领封锁清晖园软禁圣使团，遇反抗可杀无赦",
        "type_cn": "上级"
      },
      {
        "with": "夏小婉",
        "type": "ally",
        "description": "小婉与方少麟并肩守吊桥抵御骷髅魔怪，毁断吊桥将妖秽倒入湖中",
        "type_cn": "盟友"
      },
      {
        "with": "摘霞",
        "type": "crush",
        "description": "小玄调侃摘霞喜欢方少麟被摘霞追打，暗示摘霞对方少麟有好感",
        "type_cn": "暗恋"
      },
      {
        "with": "飞萝",
        "type": "ally",
        "description": "方少麟带众人前往后山观看飞萝制造的开山神弩，命人试射验证威力",
        "type_cn": "盟友"
      },
      {
        "with": "古将军",
        "type": "subordinate",
        "description": "古将军为虎头军军官，是方少麟麾下，道中之人",
        "type_cn": "下属"
      },
      {
        "with": "崔小玄",
        "type": "ally",
        "description": "小玄在方少麟书房醉酒怒吼'天若不仁便反了它'，无意间点醒方少麟从绝望中振作决定抗旨。方少麟称要改日谢恩",
        "type_cn": "盟友"
      },
      {
        "with": "夏小婉",
        "type": "crush",
        "description": "小婉对方少麟的处境深感担忧，温柔安慰。在方少麟对下属发火时能以温柔令其服软",
        "type_cn": "暗恋"
      },
      {
        "with": "季将军",
        "type": "superior",
        "description": "方少麟恢复布防后委以季将军重任，负责在最短时间内恢复泽阳全部城防",
        "type_cn": "上级"
      },
      {
        "with": "孟统领",
        "type": "superior",
        "description": "方少麟委以孟统领封锁清晖园重任，与古将军共同软禁圣使团",
        "type_cn": "上级"
      },
      {
        "with": "骷髅老祖",
        "type": "enemy",
        "description": "骷髅巢穴升起血幕，骷髅大军大举进攻泽阳城，八座地狱魔塔并排逼近城墙，方少麟率军死守",
        "type_cn": "敌人"
      },
      {
        "with": "崔采婷",
        "type": "ally",
        "description": "方少麟为泽阳城守将，向崔采婷求援城北山岭，崔采婷率众徒前往",
        "type_cn": "盟友"
      },
      {
        "with": "夏小婉",
        "type": "ambiguous",
        "description": "方少麟在崔采婷率众徒离开时低声对夏小婉说'小心'，小婉心头蓦跳双颊生晕",
        "type_cn": "暧昧"
      },
      {
        "with": "雪涵",
        "type": "ally",
        "description": "方少麟见雪涵婷婷俏立城头面容坚毅，心中涌出感动斗志冲霄",
        "type_cn": "盟友"
      },
      {
        "with": "程兆琦",
        "type": "enemy",
        "description": "程兆琦征讨云州途中遭方少麟截断后路，陷入绝境",
        "type_cn": "敌人"
      },
      {
        "with": "冯晋东",
        "type": "enemy",
        "description": "方少麟反叛占据大泽，冯晋东率虎头军征讨方少麟，在赤龙关遭真武荡魔大帝显圣阻击而溃败",
        "type_cn": "敌人"
      },
      {
        "with": "程兆琦",
        "type": "ally",
        "description": "方少麟率部扼守铁峡关，为程兆琦残部的外援力量",
        "type_cn": "盟友"
      },
      {
        "with": "龙绣霓",
        "type": "ally",
        "description": "辟邪宫三宫主龙绣霓（霞霓仙娘）已离岛前往中州助方少麟",
        "type_cn": "盟友"
      },
      {
        "with": "何晏",
        "type": "ally",
        "description": "何晏（晋安侯）在陵州公然反叛，声言与方少麟连枝同气",
        "type_cn": "盟友"
      },
      {
        "with": "费白云",
        "type": "ally",
        "description": "费白云（长丘令）在甘州公然反叛，响应方少麟",
        "type_cn": "盟友"
      },
      {
        "with": "程兆琦",
        "type": "enemy",
        "description": "方少麟声势日盛，据铁峡关堵截奉天侯程兆琦，程兆琦率疾雷军从坠星岭脱出",
        "type_cn": "敌人"
      },
      {
        "with": "林航",
        "type": "enemy",
        "description": "林航（安逸侯）奉旨挥师西南接防中州，阻击方少麟，麾下飞豹军二十万已整训完毕",
        "type_cn": "敌人"
      },
      {
        "with": "崔小玄",
        "type": "enemy",
        "description": "方少麟为叛军首领，势力强大，三日一县五日一城。小玄派董琳琳前往中州刺探其军情",
        "type_cn": "敌人"
      },
      {
        "with": "林航",
        "type": "enemy",
        "description": "方少麟挂帅中州与安逸侯林航鏖战互有胜负",
        "type_cn": "敌人"
      },
      {
        "with": "崔小玄",
        "type": "friend",
        "description": "方少麟在铁峡关遇刺客受伤，小玄被贺天雕诬陷为刺客，方少麟醒来后证实小玄并非刺客，两人战友情谊延续",
        "type_cn": "朋友"
      },
      {
        "with": "林蓉",
        "type": "lover",
        "description": "林蓉对方少麟有微妙好感",
        "type_cn": "恋人"
      },
      {
        "with": "黑白魔姬",
        "type": "enemy",
        "description": "黑白魔姬为魔界刺客，袭击方少麟致其受伤，并杀了荡魔堡贺震元",
        "type_cn": "敌人"
      }
    ],
    "talismans": [
      "伏兵符",
      "灯妖符",
      "八荒十异符（金翅飞蝎符",
      "沼泽王蟒符",
      "猛狰符）",
      "大修罗王之刃",
      "武侯符（小将军符）"
    ],
    "supplement_desc": "摘星子之徒，日月皇朝名候方尚绍之孙，前大泽令方柏钧之子，因祖父两辈功高至极，且皆已亡故，世袭一等忠靖侯，并兼封大泽令。"
  },
  "骷髅老祖": {
    "name": "骷髅老祖",
    "type": "core",
    "gender": null,
    "appearances": [
      1,
