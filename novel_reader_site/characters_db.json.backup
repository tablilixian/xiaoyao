    "relationships": [
      {
        "with": "太古真人",
        "type": "master",
        "description": "钓龙仙君为太古真人门下，在碧练岛长居数千年，修为极其高深，擅水遁诸术",
        "type_cn": "师父"
      },
      {
        "with": "焚虚真人",
        "type": "master",
        "description": "焚虚真人为太古真人，钓龙仙君之师，门下仅收三徒。焚虚真人曾于鹿吴山拿住金须龙鳌镇于定魔礁，亦于大泽镇伏骷髅老魔。",
        "type_cn": "师父"
      },
      {
        "with": "崔小玄",
        "type": "ally",
        "description": "钓龙仙君为碧练岛主人，焚虚真人门下第三徒。仙君向小玄等人详述金须龙鳌来历，以符化信天翁引路追踪巨怪行踪，赠隐鸿符以备传讯，并告知太古冥界历史。",
        "type_cn": "盟友"
      },
      {
        "with": "南海龙王敖钦",
        "type": "rival",
        "description": "南海龙王敖钦曾率龙子龙孙虾兵蟹将围困海沟欲夺龙角岩，被钓龙仙君轻松赶跑。",
        "type_cn": "对手"
      }
    ]
  },
  "红孩儿": {
