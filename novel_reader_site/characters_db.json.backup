  "晁紫阁": {
    "name": "晁紫阁",
    "type": "minor",
    "gender": "男",
    "appearances": [
      13
    ],
    "aliases": [
      "日月皇朝当今天子",
      "晁紫阁"
    ],
    "faction": "日月皇朝/邪宗圣宗",
    "description": "",
    "personality": "",
    "appearance": "",
    "image": null,
    "relationships": [
      {
        "with": "崔小玄",
        "type": "subordinate",
        "description": "晁紫阁为日月皇朝当今天子，封小玄为从四品少匠卿，命其打造机关参加仙灵大会。小玄对皇帝握武翩跹手心生醋意。皇帝不知小玄与糖妃的私情",
        "type_cn": "下属"
      },
      {
        "with": "武翩跹",
        "type": "spouse",
        "description": "武翩跹以天妃/迷妃身份入宫为妃，极得皇帝恩宠。助皇帝筑造迷楼，传授机关术。皇帝对其言听计从。武翩跹对皇帝的亲近推拒，因逍遥郎君所献七步回心极乐散被迫与皇帝入夜酣香帐中，以帐中幻象替代自己",
        "type_cn": "配偶"
      },
      {
        "with": "武翩跹",
        "type": "spouse",
        "description": "皇帝对武翩跹极为宠爱，称其为迷妃/天妃。因逍遥郎君怂恿以七步回心极乐散算计武翩跹。实为紫麒麟化身，修炼灭天鉴功法，因玄狐所袭之伤困于第五重天",
        "type_cn": "配偶"
      },
      {
        "with": "血尊",
        "type": "subordinate",
        "description": "血尊称皇帝为少主，为其护法。血尊由浓稠血流化形而成，修炼血系邪功。对皇帝忠心耿耿但暗中提防武翩跹",
        "type_cn": "下属"
      },
      {
        "with": "圣皇",
        "type": "subordinate",
        "description": "圣皇为血尊与皇帝提及的上位者，正在闭关复元。迷楼助其提前千载出关。皇帝称其为吾皇，血尊称其为吾圣宗",
        "type_cn": "下属"
      },
      {
        "with": "逍遥郎君",
        "type": "ally",
        "description": "逍遥郎君乘白龙至迷楼，献颤声娇与七步回心极乐散。皇帝与之相处甚欢，赞其风神秀逸，让其在龙床右下入座，殊为荣耀",
        "type_cn": "盟友"
      },
      {
        "with": "卜轩司",
        "type": "superior",
        "description": "卜轩司为天机岛大长老，被封护国真人拜为国师。为皇帝打造机关大军，进献七角面具压制旧伤。连番怂恿皇帝先取巨竹谷",
        "type_cn": "上级"
      },
      {
        "with": "糖妃",
        "type": "spouse",
        "description": "糖妃为淑妃，极得皇帝恩宠。皇帝不知糖妃与小玄的私情",
        "type_cn": "配偶"
      },
      {
        "with": "阎卓忠",
        "type": "superior",
        "description": "阎卓忠为皇帝身边胖大太监，常伴左右。为皇帝传旨办事，在宫中权势颇大",
        "type_cn": "上级"
      },
      {
        "with": "南宫阳",
        "type": "enemy",
        "description": "南宫阳原为镇西侯，已反叛占据云州。得邪秽魔力势极猖獗，程兆琦屡荡不灭。疑已投靠绛夕，屡派刺客谋害皇帝",
        "type_cn": "敌人"
      },
      {
        "with": "程兆琦",
        "type": "subordinate",
        "description": "程兆琦为奉天侯，皇朝四大梁柱之一，负责征讨南宫阳。屡次飞奏求援，前方难以支撑",
        "type_cn": "下属"
      },
      {
        "with": "龚世弘",
        "type": "superior",
        "description": "龚世弘为将作监将作大匠，筑造之技天下无双，得武翩跹指点与卜轩司相助建造迷楼。皇帝对其甚为倚重",
        "type_cn": "上级"
      },
      {
        "with": "韦登",
        "type": "subordinate",
        "description": "韦登为邪皇麾下百煞第九十三，潜于宫中任龙牙卫备身郎将，以守护少主（皇帝）",
        "type_cn": "下属"
      },
      {
        "with": "血尊",
        "type": "subordinate",
        "description": "血尊称皇帝为少主，为其护法驱伤。由浓稠血流化形，修炼血系邪功",
        "type_cn": "下属"
      },
      {
        "with": "糖妃",
        "type": "spouse",
        "description": "糖妃为淑妃，骠骑大将军唐凤山之女。在宫中无知心人，对小玄倾诉宫中勾心斗角",
        "type_cn": "配偶"
      },
      {
        "with": "韦登",
        "type": "subordinate",
        "description": "韦登潜于宫中任龙牙卫备身郎将，以守护少主（皇帝）",
        "type_cn": "下属"
      },
      {
        "with": "德妃",
        "type": "spouse",
        "description": "德妃为后宫妃嫔，被皇帝活活踹死",
        "type_cn": "配偶"
      },
      {
        "with": "秦湛",
        "type": "enemy",
        "description": "秦湛因妹妹德妃被皇帝虐杀而遭皇帝追捕",
        "type_cn": "敌人"
      },
      {
        "with": "卜轩司",
        "type": "subordinate",
        "description": "卜轩司为护国真人国师，效命于皇帝",
        "type_cn": "下属"
      },
      {
        "with": "武翩跹",
        "type": "enemy",
        "description": "武翩跹以迷楼一十九灵脉真灵为饵困住圣皇（邪皇渊乙），日以继夜抽取其真灵。决定立即运转无极阵改换迷楼禁制困住晁紫阁",
        "type_cn": "敌人"
      },
      {
        "with": "皇后",
        "type": "spouse",
        "description": "皇后为当今皇后，表面雍容随和实则心机深沉。暗中侵窃内库、秽乱宫掖、内诱卜轩司、外引玄龙后人、暗探皇陵机密",
        "type_cn": "配偶"
      },
      {
        "with": "凌婕妤",
        "type": "subordinate",
        "description": "凌婕妤为皇帝宠妃，实为皇帝耳目，修炼蚀魂爪。负责追踪七绝覆下落。被皇帝在炼心殿惩罚",
        "type_cn": "下属"
      },
      {
        "with": "毒眼影煞",
        "type": "subordinate",
        "description": "毒眼影煞为百煞序列第三，伪装成太监隐于禁宫做晁紫阁贴身护卫。奉皇帝之命攻击小玄与皇后",
        "type_cn": "下属"
      },
      {
        "with": "项炯",
        "type": "subordinate",
        "description": "项炯为禁卫总领，锦袍明甲阔面戟须，腰悬暗金竹节鞭",
        "type_cn": "下属"
      }
    ],
    "techniques": [
