    "image": null,
    "relationships": [
      {
        "with": "崔小玄",
        "type": "superior",
        "description": "小玄以役妖令召出犼族之王布喜，布喜化为火龙撞毁两艘冲霄飞舟；后布喜激怒水元尊者被小玄以役妖令拘回御牢",
        "type_cn": "上级"
      },
      {
        "with": "水元尊者",
        "type": "enemy",
        "description": "布喜激怒水元尊者，水元尊者以风沙千丈怒龙、漩涡符卦等神力压制布喜",
        "type_cn": "敌人"
      }
    ],
    "spells": [
      "殒火"
    ],
    "supplement_desc": "一兽，形类骏马，周身褚鳞火光缠绕，左脚爪中抓着数条疯狂挣扎的龙，右脚爪下踏着数只奄奄一息的蛟，挺胸昂首，状极威傲猛恶。 役妖令注：布喜，吼族之王，犯惊扰圣驾之罪，惩狱三千七百年。善斗，曾夺逍遥大会第十名。耗费四颗符石。"
  },
  "水元尊者": {
    "name": "水元尊者",
    "type": "minor",
    "gender": "未知",
    "appearances": [
      11
    ],
    "aliases": [],
    "faction": "玄教",
    "description": "",
    "personality": "",
    "appearance": "",
    "image": null,
    "relationships": [
      {
        "with": "崔小玄",
        "type": "ally",
        "description": "水元尊者守护梦巢最后一道防线，因布喜马化激怒而与二妖王大战，以风沙怒龙、漩涡符卦等神力压制二妖王",
        "type_cn": "盟友"
      },
      {
        "with": "布喜",
        "type": "enemy",
        "description": "布喜激怒水元尊者，水元尊者以风沙千丈怒龙、漩涡符卦等神力压制布喜",
        "type_cn": "敌人"
      },
      {
        "with": "马化",
        "type": "enemy",
        "description": "马化激怒水元尊者，水元尊者以神力压制马化",
        "type_cn": "敌人"
      }
    ],
    "supplement_desc": "这水怪上古便旦于梦巢旁的瀑布，日夜汲受梦巢喷吐出的地气精华，三皇之时便已成精，虽然灵智未开，却有殊异神力。后来梦巢为玄教所据，玄教教祖无上圣母将之收伏，再加亲手点化，予其高绝神通，赐号水元尊者，乃成守护梦巢的最后一道防线，万千年来曾击退许多争夺梦巢的仙魔鬼怪，为玄教稳据梦巢立下无数汗马功劳。"
  },
  "乙鹤道人": {
    "name": "乙鹤道人",
