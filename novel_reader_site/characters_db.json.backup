        "type_cn": "敌人"
      },
      {
        "with": "八首怪鸟将军",
        "type": "enemy",
        "description": "八首怪鸟将军突袭云水车，吞噬一头猼訑，叼走薄野烈。武翩跹以聚宝剑斩其首救下薄野烈",
        "type_cn": "敌人"
      },
      {
        "with": "少轩辕",
        "type": "ally",
        "description": "武翩跹曾引少轩辕筑造迷楼，盗取一十九灵脉真灵为饵困住魔头。少轩辕为筑造迷楼的关键人物",
        "type_cn": "盟友"
      },
      {
        "with": "薄野烈",
        "type": "subordinate",
        "description": "薄野烈为武翩跹麾下猎魔卫统领，骁勇善战。使用寻木所制长柄大斧和兽骨大弓。虞渊谷激战中浴血苦战",
        "type_cn": "下属"
      },
      {
        "with": "碧绮绮",
        "type": "enemy",
        "description": "碧绮绮得知母亲碧怜怜被武翩跹带走，决意寻人营救",
        "type_cn": "敌人"
      },
      {
        "with": "易楼",
        "type": "subordinate",
        "description": "易楼为武翩跹族人中最了得的炼器大师，已故。铸就神骨剑（太古魔神泰逢脊柱骨所制），另有两件名震天地的神兵一干一戚",
        "type_cn": "下属"
      },
      {
        "with": "墨袍鸟头人",
        "type": "enemy",
        "description": "墨袍鸟头人面如青靛发似煌炎呈鸟首状（与鲲鹏头部相同），驾驭鲲鹏率数百巨狰。修习天外魔功（以真气灵力魂魄为食），被武翩跹以近大罗之力重创",
        "type_cn": "敌人"
      },
      {
        "with": "皇后",
        "type": "enemy",
        "description": "武翩跹在仪真宫外截住皇后，以树枝抵其咽喉，警告她不要接近小玄不要横生事端",
        "type_cn": "敌人"
      },
      {
        "with": "晁紫阁",
        "type": "enemy",
        "description": "武翩跹以迷楼一十九灵脉真灵为饵困住圣皇（邪皇渊乙），日以继夜抽取其真灵。决定立即运转无极阵改换迷楼禁制困住晁紫阁",
        "type_cn": "敌人"
      },
      {
        "with": "圣皇",
        "type": "enemy",
        "description": "武翩跹以先天无极阵困住圣皇（邪皇渊乙），日以继夜抽取其真灵。圣皇被困于阵中无法脱身",
        "type_cn": "敌人"
      },
      {
        "with": "皇帝（少主）",
        "type": "enemy",
        "description": "皇帝得知圣皇被困后决定对抗武翩跹，命毒眼影煞攻击小玄与皇后",
        "type_cn": "敌人"
      },
      {
        "with": "崔小玄",
        "type": "ally",
        "description": "炼心殿之战中并肩作战击败皇帝。小玄假扮皇帝后夜探仪真宫见武翩跹，武翩跹为其检查伤势，叮嘱提防皇后与宫中党羽，告知阎卓忠是自己人。武翩跹重伤养伤期间通过红叶与小玄保持联络",
