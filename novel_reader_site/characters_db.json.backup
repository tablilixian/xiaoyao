    "personality": "",
    "appearance": "",
    "image": null,
    "relationships": [
      {
        "with": "长骸将军",
        "type": "superior",
        "description": "长骸将军为骷髅老祖麾下魔将，生前百战上将，死后被以千年蟒王之骸合体重生",
        "type_cn": "上级"
      },
      {
        "with": "双首虎",
        "type": "superior",
        "description": "双首虎为骷髅老祖麾下魔将，双头虎形魔物持奇巨阔剑",
        "type_cn": "上级"
      },
      {
        "with": "破空将军",
        "type": "superior",
        "description": "破空将军为骷髅老祖麾下魔将，背生双翼，手提骷髅头飞锤",
        "type_cn": "上级"
      },
      {
        "with": "赤甲将军",
        "type": "superior",
        "description": "高阶血骷髅，骷髅骑兵首领，驾驭骷髅战车大屠杀",
        "type_cn": "上级"
      },
      {
        "with": "妖魅女子",
        "type": "ally",
        "description": "根本教御使，代表少主监督骷髅老祖修复七邪覆",
        "type_cn": "盟友"
      },
      {
        "with": "觅鼎子",
        "type": "subordinate",
        "description": "胁迫觅鼎子在地狱之渊用五曜炉修复七邪覆长达十九年",
        "type_cn": "下属"
      },
      {
        "with": "焚虚",
        "type": "enemy",
        "description": "数百年前被聚窟洲散人焚虚诛灭（重创），骷髅老祖自称未死",
        "type_cn": "敌人"
      },
      {
        "with": "血骨巨龙",
        "type": "superior",
        "description": "原为焚虚留在大泽的禁制之枢骊龙，被骷髅老祖魔化为坐骑",
        "type_cn": "上级"
      },
      {
        "with": "焚虚",
        "type": "enemy",
        "description": "聚窟洲散人焚虚曾诛灭骷髅老祖，并在大泽留下大禁制",
        "type_cn": "敌人"
      },
      {
        "with": "圣皇",
        "type": "superior",
        "description": "圣皇为骷髅老祖背后的最高上位者，曾救骷髅老祖于绝境，即将出关",
        "type_cn": "上级"
      },
      {
        "with": "少主",
        "type": "rival",
        "description": "圣皇之子，骷髅老祖不认其权威，但忌惮圣皇出关后的力量",
        "type_cn": "对手"
      },
      {
        "with": "妖魅女子",
        "type": "manipulator",
        "description": "妖魅女子以监军身份监视骷髅老祖，了解其底细包括圣皇和血尊的过往",
        "type_cn": "操纵者"
      },
      {
        "with": "血尊",
        "type": "ally",
        "description": "圣皇遣血尊大人助骷髅老祖破去焚虚设在大泽的镇秽台",
        "type_cn": "盟友"
      },
      {
        "with": "崔小玄",
        "type": "enemy",
        "description": "骷髅老祖以噬魂化魄咒重创崔采婷，后追杀众人至湖心小岛，亲自闯入石廊擒水若，被小玄以七邪覆引开",
        "type_cn": "敌人"
      },
      {
        "with": "程水若",
        "type": "enemy",
        "description": "骷髅老祖以冥皇之爪捏碎冰麒麟并擒住水若逼问魔君之覆下落，被水若以辟邪霹雳炸断一条手臂",
        "type_cn": "敌人"
      },
      {
        "with": "焚虚散人",
        "type": "enemy",
        "description": "焚虚散人在大泽布下镇秽台和阵法群，后被血尊破去镇秽台，阵法群亦被人破掉",
        "type_cn": "敌人"
      },
      {
        "with": "妖魅女子",
        "type": "subordinate",
        "description": "妖魅女子代表少主监督骷髅老祖，对骷髅老祖有命令权，关注七绝覆下落",
        "type_cn": "下属"
      },
      {
        "with": "方少麟",
        "type": "enemy",
        "description": "骷髅巢穴升起血幕，骷髅大军大举进攻泽阳城，八座地狱魔塔并排逼近城墙，方少麟率军死守",
        "type_cn": "敌人"
      },
      {
        "with": "骷髅骨龙",
        "type": "master",
        "description": "骷髅骨龙原为骷髅老祖座驾，本卷中被崔小玄夺走控制权，骷髅老祖御龙禁制失效",
        "type_cn": "师父"
      },
      {
        "with": "崔采婷",
        "type": "enemy",
        "description": "骷髅老祖以冥皇之爪偷袭崔采婷致其重伤呕血",
        "type_cn": "敌人"
      },
      {
        "with": "易寻烟",
        "type": "enemy",
        "description": "易寻烟以正元真气破骷髅老祖护体魔功，冲散其修炼千万年的真元，骷髅老祖败逃",
        "type_cn": "敌人"
      },
      {
        "with": "飞萝",
        "type": "enemy",
        "description": "飞萝在骷髅战车上暗施惊电诀偷袭骷髅老祖，被其蹬踏制止",
        "type_cn": "敌人"
      },
      {
        "with": "血刃大将军",
        "type": "subordinate",
        "description": "血刃大将军为骷髅老祖麾下魔将，上半身人下半身蛛，指挥骷髅血蛛群围攻逍遥峰众姝",
        "type_cn": "下属"
      },
      {
        "with": "长骸将军",
        "type": "subordinate",
        "description": "长骸将军为骷髅老祖麾下得力魔将，持双股巨叉，偷袭崔小玄被殛魂盾击穿",
        "type_cn": "下属"
      },
      {
        "with": "双首虎",
        "type": "subordinate",
        "description": "双首虎为骷髅老祖麾下魔将，双头骷髅（人首+虎头），被崔小玄以缚魄链从中剖成两半",
        "type_cn": "下属"
      },
      {
        "with": "破空将军",
        "type": "subordinate",
        "description": "破空将军为骷髅老祖麾下得力魔将，身束锁子银甲背生骨翼，持骷髅头飞锤，被雪涵以金霞降彻底分解",
        "type_cn": "下属"
      },
      {
        "with": "石精之王",
        "type": "subordinate",
        "description": "石精之王为天然石精之王，成灵后经骷髅老祖秘法魔化，专门守护汲取大泽能量的法术机关",
        "type_cn": "下属"
      }
    ],
    "martial_arts": [
      "三大独门绝技（噬魂化魄咒",
      "灰飞烟灭",
      "冥皇之爪）"
    ],
    "formations": [
      "聚怨拘灵阵"
    ],
    "armor": [
      "石精之王"
    ],
    "mounts": [
      "骷髅龙御"
    ],
    "supplement_desc": "据传骷髅老祖遭众仙围剿，给聚窟洲散人焚虚诛灭后，已有数百年未曾出现过。当年焚虚诛伏了骷髅老祖后，在回聚窟洲之前，曾经到过大泽，十分忧虑那四十万不散怨魂，传言他在大泽一带设下了个大禁制。"
  },
