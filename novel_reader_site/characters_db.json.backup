        "description": "凌霄士透露受圣后之托照应玄狐，向飞萝传授虚照心经",
        "type_cn": "下属"
      },
      {
        "with": "凌霄士",
        "type": "subordinate",
        "description": "凌霄士自称受圣后之托照应玄狐，向飞萝传授虚照心经",
        "type_cn": "下属"
      },
      {
        "with": "罗可儿",
        "type": "subordinate",
        "description": "罗可儿为绝色女子（圣后）安插在迷楼的间谍，通过紫焰法符向师尊汇报情报。被命全力接近小玄查证先天太玄，承诺事成后授予太幽宫三宫主之位及幽绝宝鉴下半卷",
        "type_cn": "下属"
      },
      {
        "with": "罗可儿",
        "type": "superior",
        "description": "圣后为罗可儿师尊，统领太幽宫。命罗可儿不惜一切拿下先天太玄，承诺授予太幽宫三宫主之位及幽绝宝鉴下半卷",
        "type_cn": "上级"
      },
      {
        "with": "崔小玄",
        "type": "manipulator",
        "description": "圣后觊觎小玄腹中先天太玄，通过罗可儿暗中查证。得知小玄疑似玄狐后人",
        "type_cn": "操纵者"
      }
    ]
  },
