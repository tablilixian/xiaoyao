      },
      {
        "with": "魅影",
        "type": "subordinate",
        "description": "魅影受小玄指挥，被三首邪姬拦腰劈断后收回身影之中休养",
        "type_cn": "下属"
      },
      {
        "with": "怒天大将军",
        "type": "enemy",
        "description": "小玄与怒天大将军在磐石大阵中激战，被其重创后以七邪覆反击",
        "type_cn": "敌人"
      },
      {
        "with": "怒天大将军",
        "type": "enemy",
        "description": "怒天大将军以梼杌怒发动磐石大阵围困小玄，将其重创",
        "type_cn": "敌人"
      },
      {
        "with": "三首邪姬",
        "type": "enemy",
        "description": "三首邪姬乔装宫娥潜入太华轩偷袭小玄，将其擒住施以妒刀嫉斧之刑逼问七绝覆与大司祭下落。小玄后以莫伸手反制三首邪姬并放走她，约来日决战",
        "type_cn": "敌人"
      },
      {
        "with": "三首邪姬",
        "type": "enemy",
        "description": "三首邪姬乔装宫娥偷袭小玄，施以妒刀嫉斧之刑逼问七绝覆与大司祭下落。后被小玄以莫伸手反制",
        "type_cn": "敌人"
      },
      {
        "with": "阿绣",
        "type": "ally",
        "description": "阿绣在小玄养伤期间与婀妍、楚纯等轮流照料",
        "type_cn": "盟友"
      },
      {
        "with": "武翩跹",
        "type": "ambiguous",
        "description": "小玄被碧怜怜以阴阳蛊与蜮魇引锁困记忆后，武翩跹将其救走并谎称是其师父，带至迷楼仪真宫。武翩跹每晚亲自传授诛天诀与北溟玄数，关怀备至。因逍遥郎君所献七步回心极乐散中毒，武翩跹在药石库中情难自禁与小玄亲密，险些发生关系，被黎姑姑阻止。武翩跹咬伤小玄嘴唇与肩膀，事后对他冷淡许多。小玄对师父产生深厚情感与醋意",
        "type_cn": "暧昧"
      },
      {
        "with": "小钩子",
        "type": "ambiguous",
        "description": "小钩子与碧怜怜一同出现于巨竹堡阁楼中，被武翩跹以符印封闭经络气脉与泥丸宫，半点动弹不得。与小玄的关系不明",
        "type_cn": "暧昧"
      },
      {
        "with": "阿痴",
        "type": "ally",
        "description": "阿痴为武翩跹族中之人，真名驭痴，因痴迷机关术得名。在仪真宫操控飞鸣仙羽演习九皋辟易阵。武翩跹命其指点小玄机关术。小玄常去工匠房为其打下手，两人因同好机关术与酒而亲近",
        "type_cn": "盟友"
      },
      {
        "with": "黎姑姑",
        "type": "ally",
        "description": "黎姑姑为仪真宫管事，与武翩跹同下凡来，连皇上都敬她三分。负责照料小玄起居，教苗小见炼气。在武翩跹中七步回心极乐散时极力阻止小玄与武翩跹发生关系，称绝不可坏了身子。警告小玄不可泄露所见所闻",
        "type_cn": "盟友"
      },
      {
        "with": "红叶",
        "type": "ally",
        "description": "红叶为仪真宫黄裳少女，武翩跹的贴身侍女，外冷内热。剑技高超，小玄初次交手纯以招法比试走不出十招。偶尔指点苗小见炼气。在药石库事件中守卫夜酣香，以目光威慑警告小玄",
        "type_cn": "盟友"
      },
      {
        "with": "苗小见",
        "type": "ally",
        "description": "苗小见为仪真宫小黄门，武翩跹命其跟随小玄。热情好客，为小玄介绍宫中规矩与人物。黎姑姑教其炼气，红叶偶尔指点。与小玄关系亲近，一同追捕大宝",
        "type_cn": "盟友"
      },
      {
        "with": "糖妃",
        "type": "lover",
        "description": "小玄追捕大宝误闯红雨苑，被糖妃以法宝夜魅擒获大宝。糖妃对小玄一见倾心，约其夜间在红雨苑假山洞中相会。两人在别有洞天的采华神木下亲密，糖妃表白喜欢小玄。后因皇帝突然出现，两人躲于树上目睹皇帝化麟全过程。糖妃身上散发细腻甜香",
        "type_cn": "恋人"
      },
      {
        "with": "晁紫阁",
        "type": "subordinate",
        "description": "晁紫阁为日月皇朝当今天子，封小玄为从四品少匠卿，命其打造机关参加仙灵大会。小玄对皇帝握武翩跹手心生醋意。皇帝不知小玄与糖妃的私情",
        "type_cn": "下属"
      },
      {
        "with": "阎卓忠",
        "type": "ambiguous",
        "description": "阎卓忠为皇帝身边胖大太监，对小玄表面客气亲热，实则因武翩跹之故。在仙灵大会上主动为小玄引见龚世弘等人",
        "type_cn": "暧昧"
      },
      {
        "with": "大宝",
        "type": "superior",
        "description": "大宝在仙灵大会中展现惊人能力，自发炼造大金光符、天罗地网、阿修罗王之刃、火蝠、三煞追魂矢、金罡盾、五元归宗、大地之缚、岩浆陷阱、召唤骷髅士兵、土精、长臂族巨人、风灵等法符法阵。吞入碧色光团后爆发更强力量，背后四字符印对应四类法符。似乎开始产生心智",
        "type_cn": "上级"
      },
      {
        "with": "韦登",
        "type": "enemy",
        "description": "韦登号索魂邪煞，邪皇麾下百煞第九十三，潜于宫中任龙牙卫备身郎将守护少主。修魑魅索魂刀，小玄夜间误撞龙牙卫被其追杀。小玄以新习北溟玄数与诛天诀击败韦登及其三十二名龙牙卫",
        "type_cn": "敌人"
      },
      {
        "with": "逍遥郎君",
        "type": "rival",
        "description": "仙灵大会决赛中，小玄以大宝对战逍遥郎君的蟹霸王，大宝展现五元归宗、大地之缚等高级法符，最终令蟹霸王失去动海钟后被困，逍遥郎君认输。小玄夺魁封少国师。逍遥郎君遣紫发丽姬送如意百宝匣（内藏淫具）及请柬，意图拉拢",
        "type_cn": "对手"
      },
      {
        "with": "夭夭",
        "type": "lover",
        "description": "夭夭为桃精，与小玄在迷林中已有多时亲密关系。因饱沐玄阳至精能保持人形。对小玄极度依恋，帮他收拾屋子、端茶递水。害怕生人时会雾化隐匿",
        "type_cn": "恋人"
      },
      {
        "with": "糖妃",
        "type": "lover",
        "description": "糖妃对小玄一见倾心，主动约其夜间相会，表白喜欢他。两人在假山洞中别有洞天的采华神木下亲密。身上散发细腻甜香",
        "type_cn": "恋人"
      },
      {
        "with": "黎姑姑",
        "type": "ally",
        "description": "黎姑姑知晓太华轩竹林石阵穿越路线，能自由出入通往地下甬道的秘道。小玄目睹其走入石阵消失后模仿进入",
        "type_cn": "盟友"
      },
      {
        "with": "红叶",
        "type": "ally",
        "description": "红叶为剑技高手，常与小玄喂招切磋。初次交手小玄走不出十招",
        "type_cn": "盟友"
      },
      {
        "with": "阿痴",
        "type": "ally",
        "description": "阿痴与小玄因同好机关术与酒而亲近。小玄常去工匠房为其打下手，从阿痴处接触另一门机关妙术核心之秘",
        "type_cn": "盟友"
      },
      {
        "with": "苗小见",
        "type": "ally",
        "description": "苗小见被武翩跹命跟随小玄，热情好客，为小玄介绍宫中规矩与人物",
        "type_cn": "盟友"
      },
      {
        "with": "扈星飞",
        "type": "ally",
        "description": "仙灵大会比试中扈星飞违规入场被判负，后在枕水阁庆功宴上以照天紫电剑挑战小玄，被小玄以诛天剑诀还剑入鞘之技制服。扈星飞心服口服，两人化敌为友。扈星飞豪迈坦率，与小玄颇为投缘",
        "type_cn": "盟友"
      },
      {
        "with": "龙九公主",
        "type": "ambiguous",
        "description": "龙九公主为逍遥郎君操控蟹霸王的蒙面女子，面纱被大宝以雷电符揭去后显露真容。仙灵大会中小玄击败蟹霸王夺魁，龙九公主对此态度不明。其真实身份为西海龙王敖钦之女",
        "type_cn": "暧昧"
      },
      {
        "with": "龚才人",
        "type": "lover",
        "description": "龚才人（乳名真真）为将作大匠龚世弘之女，歌喉在宫里数一数二。与糖妃、罗才人在水月亭与小玄私会，四人发生亲密关系",
        "type_cn": "恋人"
      },
      {
        "with": "罗才人",
        "type": "lover",
        "description": "罗才人（乳名可儿）年纪最小，面容清纯但眸子深处有野意。与糖妃、龚才人在水月亭与小玄私会。罗可儿取下小玄腰间焰浣罗，发现其脐眼内藏有铭刻符文的白色异物",
        "type_cn": "恋人"
      },
      {
        "with": "阎卓忠",
        "type": "ally",
        "description": "阎卓忠被武翩跹告知是自己人，在小玄假扮皇帝期间担任贴身内相，协助小玄探望雪妃、处理宫中事务",
        "type_cn": "盟友"
      },
      {
        "with": "邓斐",
        "type": "ally",
        "description": "邓公公为皇后心腹，代表皇后送翡翠春酒并邀小玄教授机关术",
        "type_cn": "盟友"
      },
      {
        "with": "甜儿",
        "type": "ally",
        "description": "甜儿为小宫婢，只有十四五模样，为三妃与小玄牵线联络",
        "type_cn": "盟友"
      },
      {
        "with": "嬉云叟",
        "type": "ally",
        "description": "仙灵大会首轮比试中小玄以大宝对战嬉云叟的黑毛巨猿，小玄以役妖令救下失控的阿修罗王之刃下的巨猿，嬉云叟认输。后参加枕水阁庆功宴",
        "type_cn": "盟友"
      },
      {
        "with": "大耳和尚梦癫",
        "type": "ally",
        "description": "仙灵大会首轮比试中梦癫的灵偶被贺天雕的啖魔神犬撕碎。后参加枕水阁庆功宴",
        "type_cn": "盟友"
      },
      {
        "with": "陆安清",
        "type": "ally",
        "description": "仙灵大会首轮比试中陆安清的千足蜈蚣被贺天雕的三首神犬震慑化为梅树后撕碎。后参加枕水阁庆功宴",
        "type_cn": "盟友"
      },
      {
        "with": "逍遥郎君",
        "type": "rival",
        "description": "仙灵大会决赛中逍遥郎君的蟹霸王被小玄的大宝击败，动海钟被迫脱离。逍遥郎君认输后赠小玄如意百宝匣（内藏淫具）及请柬，意图拉拢",
        "type_cn": "对手"
      },
      {
        "with": "扈星飞",
        "type": "ally",
        "description": "扈星飞在枕水阁庆功宴上挑战小玄被制服后心服口服，两人化敌为友",
        "type_cn": "盟友"
      },
      {
        "with": "皇后",
        "type": "ally",
        "description": "皇后遣邓公公送翡翠春酒并邀小玄教授机关术，试图拉拢小玄",
        "type_cn": "盟友"
      },
      {
        "with": "马长安",
        "type": "subordinate",
        "description": "马长安（马公公）为阎卓忠从内侍省挑选分派到枕水阁做管家，颇能办事",
        "type_cn": "下属"
      },
      {
        "with": "阎卓忠",
        "type": "ally",
        "description": "阎卓忠带小玄参观新府枕水阁，安排庆功宴，从内侍省挑选马长安做管家",
        "type_cn": "盟友"
      },
      {
        "with": "卜轩司",
        "type": "ally",
        "description": "卜轩司以天机九变对战蟹霸王惨败后，小玄最终击败蟹霸王夺魁。卜轩司为国师，天机岛大长老",
        "type_cn": "盟友"
      },
      {
        "with": "薄野烈",
        "type": "ally",
        "description": "小玄在虞渊谷初遇薄野烈率猎魔卫与巨狰激战，以神骨剑斩杀巨狰救下薄野烈。薄野烈性格豪爽直率，与小玄并肩作战。武翩跹赠神骨剑时薄野烈在场，对小玄颇为赞赏",
        "type_cn": "盟友"
      },
      {
        "with": "罗可儿",
        "type": "ambiguous",
        "description": "罗可儿实为绝色女子（圣后）安插在迷楼的间谍，被命全力接近小玄查证先天太玄之事。罗可儿明眸皓齿清纯冶丽，曾与小玄鬼混",
        "type_cn": "暧昧"
      },
      {
        "with": "李梦棠",
        "type": "lover",
        "description": "小玄从紫发丽姬手中接回被逍遥郎君掳走的李梦棠，二人在夜光潭畔竹林月下互诉衷肠，结为连理。黎山老母发现二人关系后告诫小玄明辨是非后放行，二人含泪惜别",
        "type_cn": "恋人"
      },
      {
        "with": "墨袍鸟头人",
        "type": "enemy",
        "description": "墨袍鸟头人驾驭鲲鹏率数百巨狰降临虞渊谷，修习天外魔功（以真气灵力魂魄为食）。被武翩跹以近大罗之力重创",
        "type_cn": "敌人"
      },
      {
        "with": "双角老妇",
        "type": "enemy",
        "description": "双角老妇为墨袍鸟头人同伙，手持大布袋可喷毒瘴蟒。小玄独战数百巨狰时与其交手，最终因阴阳锁发作倒下",
        "type_cn": "敌人"
      },
      {
        "with": "薄野烈",
        "type": "ally",
        "description": "薄野烈在虞渊谷被巨狰围攻时，小玄以神骨剑斩杀巨狰救下薄野烈。两人并肩作战",
        "type_cn": "盟友"
      },
      {
        "with": "罗可儿",
        "type": "manipulator",
        "description": "罗可儿奉圣后之命全力接近小玄，查证其是否为玄狐后人及腹藏先天太玄。曾与小玄鬼混，清纯冶丽善于伪装",
        "type_cn": "操纵者"
      },
      {
        "with": "绝色女子（圣后）",
