      },
      {
        "with": "碧怜怜",
        "type": "enemy",
        "description": "碧怜怜被武翩跹囚于冰火牢笼遭受酷刑。武翩跹迫取其阴精救治小玄。碧怜怜为七绝界四大司祭之首勾魂邪姬",
        "type_cn": "敌人"
      },
      {
        "with": "崔小玄",
        "type": "ambiguous",
        "description": "小玄被碧怜怜以阴阳蛊与蜮魇引锁困记忆后，武翩跹将其救走并谎称是其师父，带至迷楼仪真宫。武翩跹每晚亲自传授诛天诀与北溟玄数，关怀备至。因逍遥郎君所献七步回心极乐散中毒，武翩跹在药石库中情难自禁与小玄亲密，险些发生关系，被黎姑姑阻止。武翩跹咬伤小玄嘴唇与肩膀，事后对他冷淡许多。小玄对师父产生深厚情感与醋意",
        "type_cn": "暧昧"
      },
      {
        "with": "黎姑姑",
        "type": "superior",
        "description": "黎姑姑为武翩跹心腹亲信，知晓迷楼及武翩跹所有秘密。两人密谈魔头苏醒、迷楼危机、大罗之境、援救父亲等重大事项。黎姑姑与阿痴一同监控无极阵",
        "type_cn": "上级"
      },
      {
        "with": "红叶",
        "type": "superior",
        "description": "红叶为武翩跹贴身侍女，随其赴玄洲虞渊谷。精通北溟玄数第二境、驭兽术和剑术。虞渊谷激战中受伤",
        "type_cn": "上级"
      },
      {
        "with": "阿痴",
        "type": "superior",
        "description": "阿痴为武翩跹族中之人，真名驭痴，痴迷机关术。在密道中秘密制造七头相柳巨物（已完成七个头），武翩跹命其打造",
        "type_cn": "上级"
      },
      {
        "with": "晁紫阁",
        "type": "spouse",
        "description": "武翩跹以天妃/迷妃身份入宫为妃，极得皇帝恩宠。助皇帝筑造迷楼，传授机关术。皇帝对其言听计从。武翩跹对皇帝的亲近推拒，因逍遥郎君所献七步回心极乐散被迫与皇帝入夜酣香帐中，以帐中幻象替代自己",
        "type_cn": "配偶"
      },
      {
        "with": "血尊",
        "type": "rival",
        "description": "血尊对皇帝进言提防武翩跹，怀疑其另有所图，推断其实力已臻大罗之境，怀疑其潜入玄教盗取先天无极阵。武翩跹对此并不知情",
        "type_cn": "对手"
      },
      {
        "with": "重元子",
        "type": "master",
        "description": "碧怜怜揭露武翩跹曾为重元子弟子，被玄狐偷上凤凰崖掳走。武翩跹实为玄教第三代弟子武技阵法机关术第一的武三绝，叛出玄教",
        "type_cn": "师父"
      },
      {
        "with": "逍遥郎君",
        "type": "enemy",
        "description": "逍遥郎君献颤声娇与七步回心极乐散给皇帝算计武翩跹。武翩跹对其极为反感，称其为龌龊野人",
        "type_cn": "敌人"
      },
      {
        "with": "晁紫阁",
        "type": "spouse",
        "description": "皇帝对武翩跹极为宠爱，称其为迷妃/天妃。因逍遥郎君怂恿以七步回心极乐散算计武翩跹。实为紫麒麟化身，修炼灭天鉴功法，因玄狐所袭之伤困于第五重天",
        "type_cn": "配偶"
      },
      {
        "with": "血尊",
        "type": "rival",
        "description": "血尊怀疑武翩跹另有所图，推断其实力已臻大罗之境，怀疑其潜入玄教盗取先天无极阵。称要盯紧她",
        "type_cn": "对手"
      },
      {
        "with": "黎姑姑",
        "type": "subordinate",
        "description": "黎姑姑与武翩跹同下凡来，连皇上都敬她三分。称武翩跹为少主。在药石库事件中极力阻止小玄与武翩跹发生关系，称绝不可坏了身子",
        "type_cn": "下属"
      },
      {
        "with": "红叶",
        "type": "subordinate",
        "description": "红叶为武翩跹贴身侍女，随其赴玄洲虞渊谷。精通北溟玄数第二境、驭兽术和剑术，负责驾车和使用驭兽符鞭",
        "type_cn": "下属"
      },
      {
        "with": "阿痴",
        "type": "subordinate",
        "description": "阿痴真名驭痴，为武翩跹族中之人。痴迷机关术，在密道中秘密制造七头相柳巨物（已完成七个头，第八个在制作中）",
        "type_cn": "下属"
      },
      {
        "with": "薄野烈",
        "type": "superior",
        "description": "薄野烈为武翩跹麾下猎魔卫统领，骁勇善战。虞渊谷激战中薄野烈浴血苦战，被八首怪鸟将军叼走，武翩跹及时赶到斩其首救下",
        "type_cn": "上级"
      },
