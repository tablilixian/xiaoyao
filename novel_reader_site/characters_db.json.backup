      },
      {
        "with": "崔小玄",
        "type": "lover",
        "description": "二人进入常羊山秘境后关系逐步突破。武翩跹目睹刑天幻象后精神崩溃，小玄以激将法激励其重振。武翩跹夜至篝火旁吐露前世欠债之言。卷末武翩跹以口渡药为小玄治眼，二人亲密关系突破，武翩跹喝令小玄再不许叫我师父",
        "type_cn": "恋人"
      },
      {
        "with": "崔小玄",
        "type": "master",
        "description": "武翩跹此前为小玄之师，本卷在常羊山秘境中传授小玄《灵犀诀》千里驭剑术。卷末关系突破后，武翩跹喝令小玄再不许叫我师父，暗示师徒关系发生根本转变",
        "type_cn": "师父"
      },
      {
        "with": "刑天",
        "type": "parent",
        "description": "武翩跹为刑天之女，万年来寻找父亲被斩首级。在消业坛棺椁中发现刑天首级已被捷足先登者取走，希望落空。计划将棺椁送回族中祭奠，并考虑前往天界寻找首级下落。",
        "type_cn": "父母"
      },
      {
        "with": "阿并",
        "type": "superior",
        "description": "武翩跹以拘心丹控制虚耗小鬼阿并，令其作为向导带领众人进入常羊山秘境。拘心丹可隔万里令服食者肠穿骨化",
        "type_cn": "上级"
      },
      {
        "with": "黎姑姑",
        "type": "ally",
        "description": "黎姑姑知晓武翩跹与刑天的关系，协助逼出虚耗小鬼，提及先天三元与界曜石，在迷楼看守接引法坛",
        "type_cn": "盟友"
      },
      {
        "with": "黎姑姑",
        "type": "senior",
        "description": "黎姑姑对武翩跹以姑姑相称，知晓其身世秘密，协助其处理秘境相关事务",
