        "description": "紫发丽姬为逍遥门人，奉逍遥郎君之命拦截凌婕妤",
        "type_cn": "下属"
      },
      {
        "with": "唐凤山",
        "type": "enemy",
        "description": "逍遥郎君化黑龙欲前往迷楼，遭唐凤山率烈火军拦截。唐彦阳挑战黑龙",
        "type_cn": "敌人"
      },
      {
        "with": "唐彦阳",
        "type": "enemy",
        "description": "唐彦阳为唐凤山长子，手执六炎神戟、胯下金睛火猊王，挑战逍遥郎君化出的黑龙",
        "type_cn": "敌人"
      },
      {
        "with": "龙九公主",
        "type": "ally",
        "description": "龙九公主擒获凌婕妤后与紫发丽姬商议将其献与逍遥郎君做炉鼎",
        "type_cn": "盟友"
      },
      {
        "with": "崔小玄",
        "type": "friend",
        "description": "逍遥郎君真名烛鼎玄，排行老三。在夜光酣结为四癫兄弟，但逍遥郎君趁机掳走李梦棠并制住雪涵等人，与玄教结仇。后经紫发丽姬将李梦棠交还小玄",
        "type_cn": "朋友"
      },
      {
        "with": "李梦棠",
        "type": "enemy",
        "description": "逍遥郎君趁朱晃擒住小玄之机掳走李梦棠，并以百战极欢散所害，后将李梦棠交还小玄",
        "type_cn": "敌人"
      },
      {
        "with": "雪涵",
        "type": "enemy",
        "description": "逍遥郎君掳走李梦棠时制住雪涵、水若、小婉等人，与玄教众弟子结仇",
        "type_cn": "敌人"
      },
      {
        "with": "程水若",
        "type": "enemy",
        "description": "逍遥郎君掳走李梦棠时制住程水若，与玄教结仇",
        "type_cn": "敌人"
      },
      {
        "with": "夏小婉",
        "type": "enemy",
        "description": "逍遥郎君掳走李梦棠时制住夏小婉，与玄教结仇",
        "type_cn": "敌人"
      },
      {
        "with": "龙九公主",
        "type": "subordinate",
        "description": "龙九公主受逍遥郎君之托前来助战，说明逍遥郎君在幕后操控多方势力",
        "type_cn": "下属"
      },
      {
        "with": "崔小玄",
        "type": "ally",
        "description": "与逍遥郎君结拜为兄弟，排行第四，称少国师。逍遥郎君赠予水晶龙御与归墟宝鉴，并邀小玄同赴不周山探索先天宝藏",
        "type_cn": "盟友"
      },
      {
        "with": "玉露娘娘",
        "type": "ally",
        "description": "玉露娘娘（玉还真）为逍遥郎君贴身三丽姬之一，追随其畔",
