        "with": "觅鼎子",
        "type": "senior",
        "description": "觅鼎子为天机岛炼器大师，在地狱深渊中遇见崔小玄，教其禁咒并将修复后的七邪覆塞给他",
        "type_cn": "前辈"
      },
      {
        "with": "绮姬",
        "type": "master",
        "description": "绮姬曾教崔小玄九鼎还丹诀，崔采婷下的缠缚咒亦由绮姬破去",
        "type_cn": "师父"
      },
      {
        "with": "程水若",
        "type": "crush",
        "description": "崔小玄在绝望中思念水若，想到'水儿会不会永远记着我'",
        "type_cn": "暗恋"
      },
      {
        "with": "夏小婉",
        "type": "sibling",
        "description": "崔小玄在绝望中想到'小婉怕是要哭死了'",
        "type_cn": "兄弟姐妹"
      },
      {
        "with": "夭夭",
        "type": "sibling",
        "description": "崔小玄在绝望中想到'夭夭怎么办？没有人放她出来，没有人给她浇水'",
        "type_cn": "兄弟姐妹"
      },
      {
        "with": "玄玄子",
        "type": "parent",
        "description": "崔小玄为玄玄子后人，先天太玄在其腹中，多方势力（天庭、七绝界、佛门等）皆欲捉拿其后代",
        "type_cn": "父母"
      },
      {
        "with": "石精之王",
        "type": "enemy",
        "description": "崔小玄以八爪炎龙鞭击碎石精之王胸前法符（九地符），后骷髅骨龙将其彻底摧毁，崔小玄获得其灵核",
        "type_cn": "敌人"
      },
      {
        "with": "胡紫儿",
        "type": "lover",
        "description": "紫儿碧儿先傲慢轻蔑后主动拦追兵相助，小玄在迷林中救出被巨熊追击的紫碧姐妹，三人在树洞避雨酒后情动交欢，关系急剧升温",
        "type_cn": "恋人"
      },
      {
        "with": "胡碧儿",
        "type": "lover",
        "description": "碧儿先傲慢轻蔑后改观，小玄在迷林中救出被巨熊追击的紫碧姐妹，三人在树洞避雨酒后情动交欢，碧儿联合紫儿以秘术反制小玄令其泄精",
        "type_cn": "恋人"
      },
      {
        "with": "贺天鹏",
        "type": "enemy",
        "description": "贺天鹏散布小玄为玄狐后人的消息，在天地无宝门口带问心观众人追杀小玄，小玄被天雷破魔咒所伤后逃离；小玄踹飞贺天鹏撞掉两颗门牙",
        "type_cn": "敌人"
      },
      {
        "with": "哪吒",
        "type": "enemy",
        "description": "哪吒奉天庭之命追索先天太玄，与飞萝、小玄激战数十合不分胜负，飞萝暗发紫犀钗射伤哪吒肩膀后败退，小玄缴获金霞风火轮",
        "type_cn": "敌人"
      },
      {
        "with": "绝色女子（圣后）",
        "type": "ambiguous",
        "description": "圣后救小玄性命，称其为'小玄玄'，态度亲密如旧识，认识前世的玄狐；赠役妖令并治愈天雷破魔咒之伤；暗中改换迷林禁制困住小玄以保护",
        "type_cn": "暧昧"
      },
      {
        "with": "白眉翁",
        "type": "ally",
        "description": "白眉翁（白眉玄鼠）在迷林中保护小玄，以一人之力对抗七绝界六大长老，为小玄医治七邪霹雳之伤",
        "type_cn": "盟友"
      },
      {
        "with": "猪哈哈",
        "type": "ally",
        "description": "小玄入住猪家客栈，以青瑛抵付房费，猪哈哈见青瑛极大极纯大为震惊，免费提供上等大套间",
        "type_cn": "盟友"
      },
      {
        "with": "小魔君",
        "type": "enemy",
        "description": "小魔君自称七绝帝君后人，因玄狐一脉与七绝帝君的世仇而追杀小玄，欲让其活着承受天地间最痛苦的事情",
        "type_cn": "敌人"
      },
      {
        "with": "绝色女子（圣后）",
        "type": "protector",
        "description": "圣后救小玄性命，赠役妖令内含十三名罪妖，治愈天雷破魔咒之伤，改换迷林禁制困住小玄以保护其安全",
        "type_cn": "保护者"
      },
      {
        "with": "胡紫儿",
        "type": "ally",
        "description": "紫儿碧儿先傲慢轻蔑后改观，主动指挥精怪拦住贺天鹏等追兵相助小玄，后与小玄在迷林中交欢",
        "type_cn": "盟友"
      },
      {
        "with": "胡碧儿",
        "type": "ally",
        "description": "碧儿先傲慢轻蔑后改观，与紫儿共同指挥精怪拦住追兵相助小玄，后与小玄在迷林中交欢",
        "type_cn": "盟友"
      },
      {
        "with": "妖狐玄玄子",
        "type": "ambiguous",
        "description": "圣后与白眉翁对话暗示小玄可能与前世玄狐有极深关联，圣后认识前世的玄狐称小玄为'小玄玄'",
        "type_cn": "暧昧"
      },
      {
        "with": "绮姬",
        "type": "ally",
        "description": "小玄使用婀妍赠送的隐形符'空空如也'实为绮姬所传，小玄暗用绮姬所传九鼎还丹诀汲纳之术",
        "type_cn": "盟友"
      },
      {
        "with": "碧绮绮",
        "type": "ambiguous",
        "description": "绮姬暗中帮助小玄逃脱，但被小魔君发现，小魔君不顾绮姬安危追击，绮姬夹在两者之间痛苦不堪",
        "type_cn": "暧昧"
      },
      {
        "with": "飞萝",
        "type": "lover",
        "description": "飞萝为救小玄不惜将内丹哺与他，二人发生亲密关系，飞萝对小玄深情至极，甚至愿为此付出一切代价",
        "type_cn": "恋人"
      },
      {
        "with": "重元子",
        "type": "enemy",
        "description": "重元子认为玄狐一脉劣根恶质，飞萝因小玄而丧失内丹令其震怒，但白眉翁暗示重元子本不会对小玄怎样",
        "type_cn": "敌人"
      },
      {
        "with": "武翩跹",
        "type": "ambiguous",
        "description": "武翩跹谎称是小玄师父将其带至迷楼，传授诛天诀与北溟玄数。因七步回心极乐散中毒险与小玄发生关系，事后态度冷淡。对小玄修习进境暗暗惊奇与思索。识破符力士来历但未详告",
        "type_cn": "暧昧"
      },
      {
        "with": "婀妍",
        "type": "lover",
        "description": "小玄以相思符意外传送至巨竹谷与婀妍重逢，坦言想她令婀妍害羞喜悦。星空下敞开心扉，小玄思念水若落泪而婀妍许愿与心爱之人遨游天地。婀妍重伤坠落瀑布时小玄不顾安危跳下救援，两人贴背并肩作战险些亲吻。小玄冒死夺回解木令救婀妍，婀妍痛哭感激。婀妍赠卧碧台醉碧楼及大量机关，两人热吻定情，婀妍表示这里永远是他的家",
        "type_cn": "恋人"
      },
      {
        "with": "夏小婉",
        "type": "ambiguous",
        "description": "小玄得知小婉暗恋自己的真相——不再去方少麟那边、不恼小玄偷看、小玄离开后悲痛哭泣担心他孤单危险。小玄心中惊涛骇浪",
        "type_cn": "暧昧"
      },
      {
        "with": "紫儿",
        "type": "lover",
        "description": "紫儿碧儿将醉倒的小玄带至竹林高地，以报复此前之事为由与小玄发生亲密关系。使用欢喜鱼吸收玄阳宝精，通宵欢好至天明。紫儿称呼从'小白哥哥'变为'好哥哥'",
        "type_cn": "恋人"
      },
      {
        "with": "碧儿",
        "type": "lover",
        "description": "碧儿大胆表白想跟喜欢的人在一起，与紫儿联手引诱小玄。使用欢喜鱼吸收宝精，性格比姐姐紫儿更为直率热烈",
        "type_cn": "恋人"
      },
      {
        "with": "楚纯",
        "type": "ally",
        "description": "小玄在元一太子对楚纯施展邪法时以役妖令拘出摩珈女王突袭元一太子，救出楚纯。楚纯目睹小玄藏身横梁全过程，羞愤难当。",
        "type_cn": "盟友"
      },
      {
        "with": "程石亦",
        "type": "ally",
        "description": "小玄认出程石亦为水若之兄，主动亲近视为未来舅子。两人并肩击杀多只恐怖之足，互相欣赏勇武",
        "type_cn": "盟友"
      },
      {
        "with": "千臂元圣",
        "type": "enemy",
        "description": "千臂元圣从太碧阴脉中窜出，夺走解木令困住小玄与婀妍。小玄以魅影夺回解木令，斩杀千臂元圣三首中的两颗，最终联手婀妍将其彻底击杀并收取灵核",
        "type_cn": "敌人"
      },
      {
        "with": "毛苦",
        "type": "enemy",
        "description": "毛苦为千臂元圣麾下总管，持有拘木令控制机关。小玄以天火焚原配合解木令将其斩杀，夺取碧色摇铃（拘木令）",
        "type_cn": "敌人"
      },
      {
        "with": "阿绣",
        "type": "ally",
        "description": "婀妍安排灵竹族工匠后裔阿绣服侍小玄，教授机关护卫操控及工匠台使用。阿绣性格温顺拘谨，对小玄渐生好感",
        "type_cn": "盟友"
      },
      {
        "with": "绝影大王",
        "type": "ally",
        "description": "绝影大王在庆功宴上认出小玄为传说中的'逍遥郎君'（逍遥门少门主），小玄含糊承认",
        "type_cn": "盟友"
      },
      {
        "with": "采缤纷",
        "type": "ambiguous",
        "description": "采缤纷战后与小玄在雨梦台偶遇，对其身体表现出浓厚兴趣，妖冶调情",
        "type_cn": "暧昧"
      },
      {
        "with": "李梦棠",
        "type": "ambiguous",
        "description": "小玄以神秘人身份救下险遭吞天吞噬的李梦棠，背其突围浴血奋战；林中藏匿时互相渡送真气疗伤，小玄被七邪覆影响对梦棠行为失控遭其掌掴；梦棠认出焰浣罗开始怀疑神秘人即小玄",
        "type_cn": "暧昧"
      },
      {
        "with": "碧怜怜",
        "type": "manipulator",
        "description": "碧怜怜识破小玄松鼠伪装后封印其灵力真气，以域魇引邪法控制心智套出身份，多次交欢采补玄阳宝精，将阴阳锁蛊种入小玄体内企图永远控制；小玄最终借魅影反制小钩子逃脱",
        "type_cn": "操纵者"
      },
      {
        "with": "碧怜怜",
        "type": "manipulator",
        "description": "碧怜怜被囚冰火牢笼中，以媚术和阴阳蜱影响试图诱使小玄救她。传授蜮魇引化解法诀但保留阴阳锁解法作为筹码。向小玄透露先天太玄的存在挑拨其与武翩跹关系",
        "type_cn": "操纵者"
      },
      {
        "with": "吞天大将军",
        "type": "enemy",
        "description": "小玄以七邪覆之力（殛魂盾、缚魄链）击退吞天大将军救下李梦棠",
        "type_cn": "敌人"
      },
      {
        "with": "七残邪煞",
        "type": "enemy",
        "description": "小玄背李梦棠突围遭天残地缺、两袖清风、没脸见人、目中无人、沆瀣一气、充耳不闻、哑口无言七人围攻，浴血奋战",
        "type_cn": "敌人"
      },
      {
        "with": "小钩子",
        "type": "enemy",
        "description": "小钩子以秘符封印小玄灵力真气，后小玄借魅影反制小钩子逼其解开封印，夺得星罗帕和销魂匣",
        "type_cn": "敌人"
      },
      {
        "with": "马化",
        "type": "superior",
        "description": "小玄以役妖令召唤战妖马化，马化称小玄为主公，一刀劈断冲霄飞舟率三百朱厌族兵为众人开路突围",
        "type_cn": "上级"
      },
      {
        "with": "贺天鹏",
        "type": "enemy",
        "description": "贺天鹏以家传追踪鹿蜀秘术为七绝界追踪小玄，确认小玄在小镇后调兵围剿",
        "type_cn": "敌人"
      },
      {
        "with": "飞萝",
        "type": "savior",
        "description": "水若告知泽阳之战后飞萝被神秘高人劫走，此前飞萝将内丹给了小玄导致功力大损，下落不明",
        "type_cn": "恩人"
      },
      {
        "with": "布喜",
        "type": "superior",
        "description": "小玄以役妖令召出犼族之王布喜，布喜化为火龙撞毁两艘冲霄飞舟；后布喜激怒水元尊者被小玄以役妖令拘回御牢",
        "type_cn": "上级"
      },
      {
        "with": "水元尊者",
        "type": "ally",
        "description": "水元尊者守护梦巢最后一道防线，因布喜马化激怒而与二妖王大战，以风沙怒龙、漩涡符卦等神力压制二妖王",
        "type_cn": "盟友"
      },
      {
        "with": "乙鹤道人",
        "type": "ally",
        "description": "乙鹤道人为小玄的忘年之交，驾鹤追上小玄赠其截教至宝兜元锦，可隐匿气息真气灵力，助其躲避晏明朱晃追踪",
        "type_cn": "盟友"
      },
      {
        "with": "小钩子",
        "type": "ambiguous",
        "description": "小钩子被碧怜怜种下阴阳锁后纠缠小玄同行，告知阴阳锁之事，试图劝诱小玄投靠碧怜怜，被小玄拒绝后赖着不走",
        "type_cn": "暧昧"
      },
      {
        "with": "晏明",
        "type": "enemy",
        "description": "晏明为重元子门下第十五弟子，玄教灵官，深谙追踪之术，修如意神游可上天入地，受命追踪小玄",
        "type_cn": "敌人"
      },
      {
        "with": "朱晃",
        "type": "enemy",
        "description": "朱晃为重元子门下第二十三弟子，玄教灵官，修机关法门与陷阱方术，与晏明同受命追踪小玄",
        "type_cn": "敌人"
      },
      {
        "with": "祝美菱",
        "type": "enemy",
        "description": "小玄被邪踪宝发现妖迹，阿菱（祝美菱）出剑攻杀，小玄以炎龙鞭抵挡后冒充灵宝宫弟子方少麒脱身",
        "type_cn": "敌人"
      },
      {
        "with": "芷晴",
        "type": "enemy",
        "description": "小玄为夺回骨龙与芷晴激战，以火牢术逼退芷晴",
        "type_cn": "敌人"
      },
      {
        "with": "苏嫣",
        "type": "enemy",
        "description": "小玄夺骨龙时与苏嫣等惊虹七仙子对立，骑骨龙飞走后与辟邪宫结下梁子",
        "type_cn": "敌人"
      },
      {
        "with": "李不",
        "type": "ambiguous",
        "description": "李不为天道阁四绝之一，随惊虹七仙子同行，在小玄冒充方少麒时似已看破其身份，赤手镇压骨龙",
        "type_cn": "暧昧"
      },
      {
        "with": "林蓉",
        "type": "ambiguous",
        "description": "小玄夺取青荷宝伞后又归还林蓉，展现善意",
        "type_cn": "暧昧"
      },
      {
        "with": "雷尉",
        "type": "enemy",
        "description": "小玄率骨龙、骄烈、邪邪赶到战场大战雷尉，三妖围攻雷尉",
        "type_cn": "敌人"
      },
      {
        "with": "骄烈",
        "type": "superior",
        "description": "小玄以役妖令仅余四颗符石拘唤鸣蛇族骁将骄烈，骄烈以火毒之术令船上敌军自燃",
        "type_cn": "上级"
      },
      {
        "with": "邪邪",
        "type": "superior",
        "description": "小玄以役妖令拘唤魅后之子邪邪，邪邪善魇能困敌于无形，仅持有者可见",
        "type_cn": "上级"
      },
      {
        "with": "化多",
        "type": "superior",
        "description": "小玄以役妖令召出令奴化多，得知符石之力机制及十三罪妖情报，仅余四颗符石可用",
        "type_cn": "上级"
      },
      {
        "with": "小妖后",
        "type": "ambiguous",
        "description": "小妖后向飞萝透露足以毁灭玄狐的秘密，暗示小玄身世秘密的危险性",
        "type_cn": "暧昧"
      },
      {
        "with": "婀妍",
        "type": "lover",
        "description": "婀妍表明已知小玄玄狐后人身份但不在乎，不让小玄离开",
        "type_cn": "恋人"
      },
      {
        "with": "楚纯",
        "type": "ambiguous",
        "description": "楚纯冒死上前以温柔话语唤回被七邪覆控制的小玄，亲手摘取七邪覆",
        "type_cn": "暧昧"
      },
      {
        "with": "楚纯",
        "type": "ally",
        "description": "楚纯与小玄联手对抗三首邪姬及怒天大将军",
        "type_cn": "盟友"
      },
      {
        "with": "碧怜怜",
        "type": "enemy",
        "description": "碧怜怜封堵太碧阴脉后与婀妍为敌，后又以蜮魇引和阴阳蛊诱捕控制小玄采补玄阳宝精",
        "type_cn": "敌人"
      },
      {
        "with": "碧怜怜",
        "type": "enemy",
        "description": "碧怜怜被囚于迷楼冰火牢笼，以媚术和阴阳蜱影响试图诱使小玄救她。传授蜮魇引化解法诀但保留阴阳锁解法作为筹码。向小玄透露其腹中藏有先天太玄。最终武翩跹迫取其阴精救治小玄",
        "type_cn": "敌人"
      },
      {
        "with": "武翩跹",
        "type": "savior",
        "description": "武翩跹现身制住碧怜怜，逼问阴阳蛊解法，解救被控制的小玄",
        "type_cn": "恩人"
      },
      {
        "with": "武翩跹",
        "type": "rival",
        "description": "武翩跹夺走七邪覆，小玄怒呼'武三绝'，两人关系复杂亦敌亦友",
        "type_cn": "对手"
      },
      {
        "with": "武翩跹",
