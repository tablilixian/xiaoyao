  "元一太子": {
    "name": "元一太子",
    "type": "minor",
    "gender": "男",
    "appearances": [
      8,
      28
    ],
    "aliases": [
      "殿下",
      "玉轩仙君"
    ],
    "faction": "未知",
    "description": "",
    "personality": "",
    "appearance": "",
    "image": null,
    "relationships": [
      {
        "with": "胡紫儿",
        "type": "ex_lover",
        "description": "紫儿曾与元一太子在一起，但遇到小玄后觉得感觉完全不同，对小玄产生了更深的情意",
        "type_cn": "前任恋人"
      },
      {
        "with": "胡碧儿",
        "type": "ex_lover",
        "description": "碧儿也曾与元一太子在一起，但同样觉得与小玄的感觉不同",
        "type_cn": "前任恋人"
      },
      {
        "with": "婀妍",
        "type": "rival",
        "description": "元一太子率军到巨竹谷外扎营，提出只要婀妍答应事成后到皇都一会便亲率大军入谷荡平七绝邪魔。婀妍对此人极为反感，战后元一太子带'大礼'到巨竹堡贺喜",
        "type_cn": "对手"
      },
      {
        "with": "云谷子",
        "type": "subordinate",
        "description": "云谷子为万劫真君麾下四大智囊其一，专侍元一太子。修为已臻太乙之境。元一太子被小玄重创后，云谷子护送其逃离前往缥缈山疗伤，途中被摩珈魔音重创。",
        "type_cn": "下属"
      },
      {
        "with": "婀妍",
        "type": "crush",
        "description": "元一太子歼灭七邪余孽后求见婀妍，云谷子曾代为说媒联姻",
        "type_cn": "暗恋"
      },
      {
        "with": "祖灵婆婆",
        "type": "ally",
        "description": "元一太子归还凤凰图鉴给巨竹谷，凤凰图鉴失而复得",
        "type_cn": "盟友"
      },
      {
        "with": "崔小玄",
        "type": "enemy",
        "description": "本卷核心敌对关系。小玄潜入鲲鹏背上的宝琼殿发现玉轩仙君即元一太子。元一太子对楚纯施展乾坤逆'驭'字法门时，小玄以役妖令拘出摩珈女王突袭元一太子重创之，并以诛天诀不离不弃刺瞎元一太子一目。两人激战激烈，小玄被元一太子蛇形奇刃割伤胸至脸。",
        "type_cn": "敌人"
      },
      {
        "with": "万劫真君",
        "type": "parent",
        "description": "万劫真君为妖界大如意天领主，元一太子之父。元一太子被小玄重创后送往缥缈山疗伤。",
        "type_cn": "父母"
      },
      {
        "with": "楚纯",
        "type": "enemy",
        "description": "元一太子对楚纯施展乾坤逆中'驭'字法门攻身拘心，企图控制楚纯。楚纯被小玄救出。元一太子觊觎楚纯已久。",
        "type_cn": "敌人"
      },
      {
        "with": "邪军师",
        "type": "enemy",
        "description": "邪军师识破玉轩仙君真实身份为元一太子，揭穿其伪装。",
        "type_cn": "敌人"
      },
      {
        "with": "严弘",
        "type": "enemy",
        "description": "元一太子一爪吸尽严弘（噬龙蛟）真灵将其杀死，展示乾坤逆功法吸取他人真灵的邪恶能力。",
        "type_cn": "敌人"
      },
      {
        "with": "宣应",
        "type": "enemy",
        "description": "宣应（断魂太岁）为邪宗魔头，被元一太子释放后一招毙命。",
        "type_cn": "敌人"
      }
    ]
  },
