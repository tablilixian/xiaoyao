    },
    {
      "id": "loc_092",
      "name": "葫芦镇",
      "type": "settlement",
      "parent": null,
      "description": "群山环抱中的隐秘大谷，河道纵横、房屋星罗棋布，乃诸界炼材师、炼器师等聚集的珍宝交易乐土，阐教门人、西天僧佛及天庭诸神不得进入，水晶潭位于镇中心",
      "first_appearance": "第七卷第一回",
      "importance": 5,
      "connections": [
