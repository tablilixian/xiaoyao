    },
    {
      "id": "loc_093",
      "name": "水晶潭",
      "type": "landmark",
      "parent": "loc_092",
      "description": "地界一十九灵脉之一，位于葫芦镇中心，产出水晶淖（绝佳炼宝材料），能使性相冲突的材料融合稳定，由截教门人空空老仙守护",
      "first_appearance": "第七卷第一回",
      "importance": 4,
      "connections": [
        "loc_092"
      ]
    },
    {
      "id": "loc_094",
      "name": "猪家客栈",
      "type": "building",
      "parent": "loc_092",
      "description": "葫芦镇上的客栈，临河而筑架于桥头之上，老板为猪精猪哈哈，以猪家蹄子闻名，装潢富丽雅致",
      "first_appearance": "第七卷第一回",
      "importance": 3,
      "connections": [
        "loc_092"
      ]
    },
    {
      "id": "loc_095",
      "name": "天地无宝",
      "type": "building",
      "parent": "loc_092",
      "description": "葫芦镇上规模最大的珍宝店铺，十余层高塔，分七色铭牌等级，售卖各种珍稀材料、兵器法宝及奇禽异兽，属空空老仙产业",
      "first_appearance": "第七卷第五回",
      "importance": 4,
      "connections": [
        "loc_092"
      ]
    },
    {
      "id": "loc_096",
      "name": "迷林",
      "type": "natural",
      "parent": null,
      "description": "葫芦镇内隐藏的巨大森林秘境，无边无际，清者自清迷者自迷，内有猛禽恶兽，白眉翁隐居其中，实为某结界或秘境入口",
      "first_appearance": "第七卷第六回",
